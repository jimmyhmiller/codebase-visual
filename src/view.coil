(defstruct MiniTriangle
  [(island i64) (a r/Vector2) (b r/Vector2) (c r/Vector2) (color r/Color)])

(defstruct View
  [(camera r/Camera3D)
   (target r/Vector3)
   (yaw f64)
   (pitch f64)
   (zoom f64)
   (desired-zoom f64)
   (fit-zoom f64)
   (cursor-zoom bool)
   (zoom-offset r/Vector2)
   (selected i64)
   (selected-island i64)
   (island-counts (al/ArrayList i64))
   (folders folders/State)
   (folder-borders (al/ArrayList r/Vector3))
   (folder-layout-count i64)
   (show-borders bool)
   (show-links bool)
   (revealed-island i64)
   (town-hall r/Model)
   (town-coarse r/Model)
   (loading-history bool)
   (pointer-down bool)
   (pointer-dragged bool)
   (pointer-origin r/Vector2)
   (selected-member i64)
   (member-owner i64)
   (hovered i64)
   (width i64)
   (height i64)
   (font r/Font)
   (bold r/Font)
   (texture r/RenderTexture)
   (minimap r/RenderTexture)
   (minimap-dirty bool)
   (minimap-triangles (al/ArrayList MiniTriangle))
   (minimap-layout-count i64)
   (projection r/Matrix)
   (terrain r/Model)
   (terrain-chunks (al/ArrayList terrain/Chunk))
   (proxies (array (al/ArrayList r/Matrix) 4))
   (proxy-model r/Model)
   (proxies-dirty bool)
   (proxies-selected i64)
   (water r/Model)
   (ocean r/Shader)
   (trees (array r/Model 17))
   (slabs (array r/Model 45))
   (courtyards (array r/Model 5))
   (functions (array r/Model 5))
   (pick-bounds (array r/BoundingBox 24))
   (time f64)
   (speed f64)
   (help bool)
   (source-open bool)
   (light r/Shader)
   (depth r/Shader)
   (post r/Shader)
   (shadow r/RenderTexture)
   (mode i64)
   (age f64)
   (activity r/Vector3)
   (activity-origin r/Vector3)
   (activity-target r/Vector3)
   (activity-known bool)
   (read-errors i64)
   (repository-scroll f64)
   (inspector-scroll f64)
   (search search/Search)
   (input-blocked bool)
   (shadow-ms f64)
   (world-ms f64)
   (present-ms f64)
   (terrain-ms f64)
   (glyph-ms f64)
   (water-ms f64)
   (routes-ms f64)
   (streets-ms f64)
   (impact-selected i64)
   (impact-distances (al/ArrayList i64))
   (impact-summary impact/Summary)])

(defn fit-world! [(v (ptr View)) (w (ptr world/World))] (-> i64)
  (fit-islands! v (load (field w islands)) true))

(defn fit-islands! [(v (ptr View))
                    (islands (al/ArrayList m/Island))
                    (immediate bool)] (-> i64)
  (block :fit
         (store! (field v cursor-zoom) false)
         (if (= (al/al-len islands) 0)
             (do
               (store! (field v target) (r/v3 0.0 0.0 0.0))
               (store! (field v desired-zoom) 40.0)
               (store! (field v zoom) 40.0)
               (break :fit 0))
             0)
         (let [(mut minx) 0.0
               (mut maxx) 0.0
               (mut miny) 0.0
               (mut maxy) 0.0
               yaw (load (field v yaw))
               pitch (load (field v pitch))
               (mut i) 0]
           (loop (if (>= (load i) (al/al-len islands))
                     (break 0)
                     0)
             (let [island (al/al-get islands (load i))
                   p (load (field island position))
                   x (cast f64 (load (field p x)))
                   z (cast f64 (load (field p z)))
                   sx (- (* x (r/cos yaw)) (* z (r/sin yaw)))
                   sy (* (+ (* x (r/sin yaw)) (* z (r/cos yaw))) (r/sin pitch))
                   radius (* (load (field island radius)) 1.35)
                   top (- sy (+ (* radius (r/sin pitch)) (* 4.8 (r/cos pitch))))
                   bottom
                     (+ sy (+ (* radius (r/sin pitch)) (* 0.5 (r/cos pitch))))]
               ;; Seed from real geometry, not a coordinate-range sentinel. A world
               ;; translated far from the origin must fit identically to a local one.
               (if (= (load i) 0)
                   (do
                     (store! minx (- sx radius))
                     (store! maxx (+ sx radius))
                     (store! miny top)
                     (store! maxy bottom)
                     0)
                   0)
               (store! minx
                       (if (< (- sx radius) (load minx))
                           (- sx radius)
                           (load minx)))
               (store! maxx
                       (if (> (+ sx radius) (load maxx))
                           (+ sx radius)
                           (load maxx)))
               (store! miny
                       (if (< top (load miny))
                           top
                           (load miny)))
               (store! maxy
                       (if (> bottom (load maxy))
                           bottom
                           (load maxy))))
             (store! i (+ (load i) 1)))
           (let [sx (* 0.5 (+ (load minx) (load maxx)))
                 sy (/ (* 0.5 (+ (load miny) (load maxy))) (r/sin pitch))
                 aspect
                   (/ (cast f64 (- (load (field v width)) 500))
                      (cast f64 (- (load (field v height)) 176)))
                 h (/ (- (load maxy) (load miny)) 0.88)
                 wide (/ (- (load maxx) (load minx)) (* aspect 0.88))
                 zoom (if (> h wide) h wide)]
             (store! (field v target)
                     (r/v3 (+ (* sx (r/cos yaw)) (* sy (r/sin yaw)))
                           0.0
                           (- (* sy (r/cos yaw)) (* sx (r/sin yaw)))))
             (store! (field v desired-zoom) zoom)
             (store! (field v fit-zoom) zoom)
             (if immediate (store! (field v zoom) zoom) 0))
           0)))

(defn island-screen-bounds [(v (ptr View)) (island m/Island)] (-> r/Rectangle)
  (let [screen
          (r/GetWorldToScreenEx (load (field island position))
                                (load (field v camera))
                                (cast i32 (- (load (field v width)) 500))
                                (cast i32 (- (load (field v height)) 176)))
        scale
          (/ (cast f64 (- (load (field v height)) 176)) (load (field v zoom)))
        rx (* (* (load (field island radius)) (land/main-coast-bound)) scale)
        ry (* rx (r/sin (load (field v pitch))))
        roof (* (* 4.8 (r/cos (load (field v pitch)))) scale)
        water (* (* 0.5 (r/cos (load (field v pitch)))) scale)]
    (r/rect (- (+ 200.0 (cast f64 (load (field screen x)))) rx)
            (- (- (+ 76.0 (cast f64 (load (field screen y)))) ry) roof)
            (* 2.0 rx)
            (+ (* 2.0 ry) (+ roof water)))))

(defn label-shore-anchor [(v (ptr View)) (island m/Island) (box r/Rectangle)] (-> r/Vector2)
  (let [center (load (field island position))
        seed (* (cast f64 (% (load (field island seed)) 997)) 0.019)
        x
          (+ (cast f64 (load (field box x)))
             (* 0.5 (cast f64 (load (field box width)))))
        y
          (+ (cast f64 (load (field box y)))
             (* 0.5 (cast f64 (load (field box height)))))
        (mut best) (r/v2 x y)
        (mut distance) 1.0e30
        (mut i) 0]
    (loop (if (>= (load i) 128) (break 0) 0)
      (let [angle (* (/ (cast f64 (load i)) 128.0) 6.283185307179586)
            radius
              (* (* (load (field island radius)) (land/coast-scale))
                 (land/coast seed angle (land/coast-scale)))
            p
              (r/v3 (+ (cast f64 (load (field center x)))
                       (* radius (r/cos angle)))
                    -0.3
                    (+ (cast f64 (load (field center z)))
                       (* radius (r/sin angle))))
            screen
              (r/GetWorldToScreenEx p
                                    (load (field v camera))
                                    (cast i32 (- (load (field v width)) 500))
                                    (cast i32 (- (load (field v height)) 176)))
            sx (+ 200.0 (cast f64 (load (field screen x))))
            sy (+ 76.0 (cast f64 (load (field screen y))))
            d (+ (* (- sx x) (- sx x)) (* (- sy y) (- sy y)))]
        (if (< d (load distance))
            (do (store! distance d) (store! best (r/v2 sx sy)))
            0))
      (store! i (+ (load i) 1)))
    (load best)))

(defn label-width [(v (ptr View))
                   (a (dyn alloc/Allocator))
                   (s (slice u8))
                   (size f32)] (-> f64)
  (let [measured
          (r/MeasureTextEx (load (field v font)) (str/str->cstr a s) size 0.5)]
    (+ 16.0 (cast f64 (load (field measured x))))))

(defn select-island! [(v (ptr View))
                      (w (ptr world/World))
                      (index i64)
                      (focus bool)] (-> i64)
  (if (and (>= index 0) (< index (al/al-len (load (field w islands)))))
      (let [island (al/al-get (load (field w islands)) index)]
        (store! (field v selected-island) index)
        (store! (field (field v folders) selected) -1)
        (store! (field v selected) -1)
        (store! (field v selected-member) -1)
        (store! (field v inspector-scroll) 0.0)
        (if focus
            (do
              (store! (field v cursor-zoom) false)
              (store! (field v target) (load (field island position)))
              (store! (field v desired-zoom)
                      (* 3.2 (load (field island radius)))))
            0)
        0)
      0))

(defn town-point [(island m/Island)] (-> r/Vector3)
  (let [p (load (field island position))]
    (r/v3 (cast f64 (load (field p x)))
          1.99
          (cast f64 (load (field p z))))))

(defn close-folders! [(v (ptr View))] (-> i64)
  (folders/close! (field v folders))
  (al/al-free! (field v folder-borders))
  0)

(defn refresh-folders! [(v (ptr View))
                        (w (ptr world/World))
                        (snapshot (ptr m/Snapshot))] (-> i64)
  (folders/refresh! (field v folders)
                    (field w folders)
                    snapshot
                    (al/al-len (load (field w islands))))
  (store! (field v minimap-dirty) true)
  (store! (field v proxies-dirty) true)
  (let [at (load (field v selected))]
    (if (and (>= at 0) (< at (al/al-len (load (field snapshot entities)))))
        (let [e (al/al-get (load (field snapshot entities)) at)]
          (store! (field v selected-island) (load (field e island))))
        0))
  (if (and (>= (load (field v selected-island)) 0)
           (not (island-present? v (load (field v selected-island)))))
      (do (store! (field v selected-island) -1) (store! (field v selected) -1))
      0)
  (let [at (load (field v selected))]
    (if (and (>= at 0) (< at (al/al-len (load (field snapshot entities)))))
        (let [e (al/al-get (load (field snapshot entities)) at)]
          (if (not (island-present? v (load (field e island))))
              (store! (field v selected) -1)
              0))
        0))
  (store! (field v hovered) -1)
  (store! (field v activity-known) false)
  (let [(mut i) 0
        entities (load (field snapshot entities))]
    (loop (if (>= (load i) (al/al-len entities)) (break 0) 0)
      (let [e (al/al-get entities (load i))]
        (if (and (!= (load (field e state)) 0)
                 (island-present? v (load (field e island))))
            (do
              (store! (field v activity-known) true)
              (store! (field v activity-target) (load (field e position)))
              (store! (field v activity-origin) (load (field e position)))
              (break 0))
            0))
      (store! i (+ (load i) 1))))
  (let [nodes (load (field (field w folders) nodes))
        version (+ (al/al-len nodes) (al/al-len (load (field w registry))))]
    (if (!= version (load (field v folder-layout-count)))
        (let [(mut i) 0]
          (al/al-clear! (field v folder-borders))
          (loop (if (>= (load i)
                        (al/al-len (load (field (field w folders) borders))))
                    (break 0)
                    0)
            (al/al-push! (field v folder-borders)
                         (al/al-get (load (field (field w folders) borders))
                                    (load i)))
            (store! i (+ (load i) 1)))
          (store! (field v folder-layout-count) version)
          0)
        0))
  0)

(defn focus-folder! [(v (ptr View)) (w (ptr world/World)) (at i64)] (-> i64)
  (let [node (al/al-get (load (field (field w folders) nodes)) at)]
    (store! (field (field v folders) selected) at)
    (store! (field v selected) -1)
    (store! (field v selected-island) -1)
    (store! (field v inspector-scroll) 0.0)
    (let [nodes (load (field (field w folders) nodes))
          (mut visible) (al/al-new [m/Island] (alloc/malloc-allocator))
          (mut i) at]
      (loop (if (>= (load i) (al/al-len nodes)) (break 0) 0)
        (let [n (al/al-get nodes (load i))
              island (load (field n island))]
          (if (and (>= island 0)
                   (island-present? v island)
                   (folders/descendant? (field w folders) (load i) at))
              (al/al-push! (mut visible)
                           (al/al-get (load (field w islands)) island))
              0))
        (store! i (+ (load i) 1)))
      (if (> (al/al-len (load visible)) 0)
          (fit-islands! v (load visible) false)
          0)
      (al/al-free! (mut visible)))
    (if (and (not (load (field node directory)))
             (>= (load (field node island)) 0))
        (select-island! v w (load (field node island)) true)
        0)
    0))

(defn folder-indent [(node folders/Node)] (-> f64)
  (r/clamp (* 9.0 (cast f64 (load (field node depth)))) 0.0 81.0))

(defn folder-input! [(v (ptr View))
                     (w (ptr world/World))
                     (snapshot (ptr m/Snapshot))
                     (clicked bool)
                     (mx f64)
                     (my f64)
                     (bottom f64)] (-> i64)
  (let [selected (load (field v selected))]
    (if (and (>= selected 0)
             (< selected (al/al-len (load (field snapshot entities)))))
        (let [e (al/al-get (load (field snapshot entities)) selected)]
          (store! (field v selected-island) (load (field e island))))
        0))
  (let [island (load (field v selected-island))]
    (if (and (>= island 0) (!= island (load (field v revealed-island))))
        (let [site (al/al-get (load (field w islands)) island)
              node
                (folders/find-file (field w folders) (load (field site name)))
              (mut at) node]
          (loop (if (< (load at) 0) (break 0) 0)
            (store! (al/al-elem [bool]
                                (field (field v folders) enabled)
                                (load at))
                    true)
            (let [n (al/al-get (load (field (field w folders) nodes)) (load at))]
              (store! at (load (field n parent))))
            (if (>= (load at) 0)
                (store! (al/al-elem [bool]
                                    (field (field v folders) expanded)
                                    (load at))
                        true)
                0))
          (refresh-folders! v w snapshot)
          (store! (field v revealed-island) island)
          (let [(mut row) 0
                rows (load (field (field v folders) rows))]
            (loop (if (>= (load row) (al/al-len rows)) (break 0) 0)
              (if (= (al/al-get rows (load row)) node)
                  (let [y (* 31.0 (cast f64 (load row)))
                        offset (load (field v repository-scroll))
                        height (- bottom 524.0)]
                    (if (< y offset) (store! (field v repository-scroll) y) 0)
                    (if (> (+ y 31.0) (+ offset height))
                        (store! (field v repository-scroll)
                                (- (+ y 31.0) height))
                        0)
                    (break 0))
                  0)
              (store! row (+ (load row) 1))))
          0)
        0))
  (if (or (key-pressed? v 66)
          (and clicked (> mx 18.0) (< mx 105.0) (> my 137.0) (< my 155.0)))
      (store! (field v show-borders) (not (load (field v show-borders))))
      0)
  (if (or (key-pressed? v 71)
          (and clicked (>= mx 105.0) (< mx 195.0) (> my 137.0) (< my 155.0)))
      (store! (field v show-links) (not (load (field v show-links))))
      0)
  (let [state (field v folders)
        rows (load (field state rows))
        height (r/clamp (- bottom 524.0) 0.0 10000.0)
        maximum
          (r/clamp (- (* 31.0 (cast f64 (al/al-len rows))) height)
                   0.0
                   1000000.0)]
    (store! (field v repository-scroll)
            (r/clamp (load (field v repository-scroll)) 0.0 maximum))
    (if (and (> mx 18.0)
             (< mx 195.0)
             (> my 157.0)
             (< my (- bottom 367.0))
             (not (load (field v input-blocked))))
        (do
          (store! (field v repository-scroll)
                  (r/clamp (- (load (field v repository-scroll))
                              (* 31.0 (cast f64 (r/GetMouseWheelMove))))
                           0.0
                           maximum))
          (let [row
                  (cast i64
                        (/ (+ (- my 157.0) (load (field v repository-scroll)))
                           31.0))]
            (if (and clicked (>= row 0) (< row (al/al-len rows)))
                (let [at (al/al-get rows row)
                      node (al/al-get (load (field (field w folders) nodes)) at)
                      arrow (+ 42.0 (folder-indent node))]
                  (cond (< mx 37.0)
                          (folders/toggle! state (field w folders) snapshot at)
                        (and (load (field node directory))
                             (>= mx (- arrow 3.0))
                             (< mx (+ arrow 14.0)))
                          (let [out
                                  (al/al-elem [bool] (field state expanded) at)]
                            (store! out (not (load out)))
                            0)
                        :else (focus-folder! v w at))
                  (refresh-folders! v w snapshot))
                0))
          0)
        0)
    (if (key-pressed? v 259)
        (let [(mut at) (load (field state selected))]
          (if (and (< (load at) 0) (>= (load (field v selected-island)) 0))
              (let [island
                      (al/al-get (load (field w islands))
                                 (load (field v selected-island)))]
                (store! at
                        (folders/find-file (field w folders)
                                           (load (field island name)))))
              0)
          (if (> (load at) 0)
              (let [node
                      (al/al-get (load (field (field w folders) nodes))
                                 (load at))]
                (focus-folder! v w (load (field node parent))))
              0))
        0)
    0))

(defn folder-tree-ui! [(v (ptr View))
                       (w (ptr world/World))
                       (snapshot (ptr m/Snapshot))
                       (a (dyn alloc/Allocator))
                       (bottom f64)] (-> i64)
  (let [state (field v folders)
        rows (load (field state rows))
        (mut i) 0]
    (r/BeginScissorMode 18 157 177 (cast i32 (- bottom 524.0)))
    (loop (if (>= (load i) (al/al-len rows)) (break 0) 0)
      (let [at (al/al-get rows (load i))
            node (al/al-get (load (field (field w folders) nodes)) at)
            y
              (- (+ 161.0 (* 31.0 (cast f64 (load i))))
                 (load (field v repository-scroll)))
            shown (al/al-get (load (field state shown)) at)
            count (folders/count-at snapshot at)
            x (+ 42.0 (folder-indent node))
            color
              (if (> shown 0) (r/rgba 203 216 212 255) (r/rgba 92 113 119 255))]
        (if (and (> (+ y 25.0) 157.0) (< y (- bottom 367.0)))
            (do
              (if (or (= at (load (field state selected)))
                      (and (>= (load (field node island)) 0)
                           (= (load (field node island))
                              (load (field v selected-island)))))
                  (do
                    (r/DrawRectangle 18
                                     (cast i32 (- y 3.0))
                                     177
                                     29
                                     (r/rgba 34 56 63 255))
                    0)
                  0)
              (r/DrawRectangleLines 23 (cast i32 (+ y 3.0)) 11 11 color)
              (if (> shown 0)
                  (do
                    (r/DrawRectangle 26
                                     (cast i32
                                           (+ y (if (= shown count) 6.0 8.0)))
                                     5
                                     (if (= shown count) 5 2)
                                     color)
                    0)
                  0)
              (if (load (field node directory))
                  (text v
                        a
                        (if (al/al-get (load (field state expanded)) at)
                            "v"
                            ">")
                        x
                        y
                        12.0
                        color)
                  0)
              (text v
                    a
                    (if (= at 0)
                        "Repository"
                        (leaf-name (load (field node path))))
                    (+ x 14.0)
                    y
                    12.0
                    color)
              0)
            0))
      (store! i (+ (load i) 1)))
    (r/EndScissorMode)
    0))

(defn territory-visible? [(v (ptr View)) (w (ptr world/World)) (at i64)] (-> bool)
  (let [node (al/al-get (load (field (field w folders) nodes)) at)
        shown (load (field (field v folders) shown))
        parent (load (field node parent))]
    (and (load (field v show-borders))
         (> at 0)
         (load (field node directory))
         (> (load (field node radius)) 0.0)
         (< at (al/al-len shown))
         (> (al/al-get shown at) 0)
         (or (= at (load (field (field v folders) selected)))
             (< (load (field node radius)) (* 1.25 (load (field v zoom)))))
         (or (= (load (field node depth)) 1)
             (and (> (load (field node radius)) (* 0.04 (load (field v zoom))))
                  (let [p
                          (al/al-get (load (field (field w folders) nodes))
                                     parent)]
                    (> (load (field p radius)) (* 0.65 (load (field v zoom))))))))))

(defn territories! [(v (ptr View)) (w (ptr world/World))] (-> i64)
  (let [(mut i) 1]
    (loop (if (>= (load i) (al/al-len (load (field (field w folders) nodes))))
              (break 0)
              0)
      (if (territory-visible? v w (load i))
          (let [node (al/al-get (load (field (field w folders) nodes)) (load i))
                first (load (field node border-first))
                (mut j) 0
                color
                  (if (= (load i) (load (field (field v folders) selected)))
                      (r/rgba 177 201 191 190)
                      (r/rgba 105 149 162 105))]
            (loop (if (>= (load j) (load (field node border-count)))
                      (break 0)
                      0)
              (r/DrawLine3D (al/al-get (load (field v folder-borders))
                                       (+ first (load j)))
                            (al/al-get (load (field v folder-borders))
                                       (+ first (+ (load j) 1)))
                            color)
              (store! j (+ (load j) 2))))
          0)
      (store! i (+ (load i) 1)))
    0))

(defn territory-labels! [(v (ptr View))
                         (w (ptr world/World))
                         (a (dyn alloc/Allocator))] (-> i64)
  (let [(mut i) 1]
    (r/BeginScissorMode 200
                        157
                        (cast i32 (- (load (field v width)) 500))
                        (cast i32 (- (load (field v height)) 257)))
    (loop (if (>= (load i) (al/al-len (load (field (field w folders) nodes))))
              (break 0)
              0)
      (if (territory-visible? v w (load i))
          (let [node (al/al-get (load (field (field w folders) nodes)) (load i))
                point (load (field node border-label))
                p
                  (r/GetWorldToScreenEx point
                                        (load (field v camera))
                                        (cast i32
                                              (- (load (field v width)) 500))
                                        (cast i32
                                              (- (load (field v height)) 176)))]
            (text v
                  a
                  (leaf-name (load (field node path)))
                  (+ 204.0 (cast f64 (load (field p x))))
                  (+ 76.0 (cast f64 (load (field p y))))
                  14.0
                  (r/rgba 163 198 204 255)))
          0)
      (store! i (+ (load i) 1)))
    (r/EndScissorMode)
    0))

(defn folder-inspector! [(v (ptr View))
                         (w (ptr world/World))
                         (snapshot (ptr m/Snapshot))
                         (a (dyn alloc/Allocator))
                         (right f64)] (-> i64)
  (let [at (load (field (field v folders) selected))
        node (al/al-get (load (field (field w folders) nodes)) at)
        x (+ right 22.0)
        color (r/rgba 205 217 212 255)
        declarations (al/al-get (load (field snapshot folder-structures)) at)
        changed (al/al-get (load (field snapshot folder-changed)) at)
        removed (al/al-get (load (field snapshot folder-removed)) at)]
    (label v
           a
           (if (load (field node directory))
               "FOLDER / ARCHIPELAGO"
               "FILE / NO STRUCTURES")
           x
           94.0)
    (prose! v
            a
            (if (= at 0) "Repository" (load (field node path)))
            x
            125.0
            256.0
            20.0
            5
            color)
    (text v
          a
          (str/cstr->str (r/TextFormat c"%lld files / %lld visible"
                                       (folders/count-at snapshot at)
                                       (al/al-get (load (field (field v folders)
                                                               shown))
                                                  at)))
          x
          270.0
          14.0
          color)
    (text v
          a
          (str/cstr->str (r/TextFormat c"%lld present structures" declarations))
          x
          305.0
          14.0
          color)
    (text v
          a
          (str/cstr->str (r/TextFormat c"%lld changed / %lld removed"
                                       changed
                                       removed))
          x
          340.0
          14.0
          color)
    (prose! v
            a
            "Counts belong to this revision and include the entire subtree. Borders reserve stable space across history."
            x
            390.0
            250.0
            14.0
            5
            color)
    (prose! v
            a
            "Checkbox: show or hide subtree. Arrow: expand folder. Backspace: parent territory."
            x
            510.0
            250.0
            14.0
            5
            color)
    (prose! v a (load (field snapshot revision)) x 645.0 250.0 11.0 2 color)
    0))

(defn island-population [(v (ptr View)) (index i64)] (-> i64)
  (let [counts (load (field v island-counts))]
    (if (and (>= index 0) (< index (al/al-len counts)))
        (al/al-get counts index)
        0)))

(defn island-present? [(v (ptr View)) (index i64)] (-> bool)
  (let [mask (load (field (field v folders) islands))]
    (if (= (al/al-len mask) 0)
        (> (island-population v index) 0)
        (and (>= index 0) (< index (al/al-len mask)) (al/al-get mask index)))))

(defn present-island-count [(v (ptr View))] (-> i64)
  (let [(mut i) 0
        (mut total) 0]
    (loop (if (>= (load i) (al/al-len (load (field v island-counts))))
              (break (load total))
              0)
      (if (island-present? v (load i)) (store! total (+ (load total) 1)) 0)
      (store! i (+ (load i) 1)))))

(defn town-bounds [(v (ptr View)) (island m/Island)] (-> r/Rectangle)
  (let [p
          (r/GetWorldToScreenEx (town-point island)
                                (load (field v camera))
                                (cast i32 (- (load (field v width)) 500))
                                (cast i32 (- (load (field v height)) 176)))]
    (r/rect (+ 187.0 (cast f64 (load (field p x))))
            (+ 63.0 (cast f64 (load (field p y))))
            26.0
            26.0)))

(defn town-visible? [(v (ptr View)) (island m/Island) (index i64)] (-> bool)
  (and (island-present? v index)
       (or (= index (load (field v selected-island)))
           (>= (/ (* (load (field island radius))
                     (cast f64 (- (load (field v height)) 176)))
                  (load (field v zoom)))
               15.0))
       (position-visible? v (town-point island) 0.0)))

(defn town-hit [(v (ptr View)) (w (ptr world/World)) (mouse r/Vector2)] (-> i64)
  (let [(mut i) 0
        (mut best) -1
        (mut distance) 1.0e30
        ray
          (r/GetScreenToWorldRayEx (r/v2 (- (cast f64 (load (field mouse x)))
                                            200.0)
                                         (- (cast f64 (load (field mouse y)))
                                            76.0))
                                   (load (field v camera))
                                   (cast i32 (- (load (field v width)) 500))
                                   (cast i32 (- (load (field v height)) 176)))]
    (loop (if (>= (load i) (al/al-len (load (field w islands))))
              (break (load best))
              0)
      (let [island (al/al-get (load (field w islands)) (load i))]
        (if (island-present? v (load i))
            (let [hit
                    (r/GetRayCollisionBox ray
                                          (town/bounds (town-point island)
                                                       (island-population v
                                                                          (load i))))]
              (if (and (!= (load (field hit hit)) (cast u8 0))
                       (< (cast f64 (load (field hit distance)))
                          (load distance)))
                  (do
                    (store! best (load i))
                    (store! distance (cast f64 (load (field hit distance)))))
                  0))
            0))
      (store! i (+ (load i) 1)))))

(defn towns-ui! [(v (ptr View))
                 (w (ptr world/World))
                 (snapshot (ptr m/Snapshot))
                 (a (dyn alloc/Allocator))] (-> i64)
  (let [selected (load (field v selected))]
    (if (and (>= selected 0)
             (< selected (al/al-len (load (field snapshot entities)))))
        (let [e (al/al-get (load (field snapshot entities)) selected)]
          (store! (field v selected-island) (load (field e island))))
        0))
  (let [(mut i) 0
        (mut occupied) (al/al-new [r/Rectangle] a)]
    (r/BeginScissorMode 200
                        124
                        (cast i32 (- (load (field v width)) 500))
                        (cast i32 (- (load (field v height)) 252)))
    (loop (if (>= (load i) (al/al-len (load (field w islands)))) (break 0) 0)
      (let [island (al/al-get (load (field w islands)) (load i))]
        (if (town-visible? v island (load i))
            (let [box (town-bounds v island)
                  x (cast f64 (load (field box x)))
                  y (cast f64 (load (field box y)))
                  color
                    (if (= (load i) (load (field v selected-island)))
                        (r/rgba 255 188 83 255)
                        (r/rgba 193 212 199 240))]
              (let [name (leaf-name (load (field island name)))
                    bounds
                      (r/rect (+ x 30.0)
                              (+ y 3.0)
                              (+ 5.0 (label-width v a name 14.0))
                              20.0)
                    (mut clear) true
                    (mut j) 0]
                (loop (if (>= (load j) (al/al-len (load occupied))) (break 0) 0)
                  (if (map-labels/overlaps? bounds
                                            (al/al-get (load occupied) (load j)))
                      (store! clear false)
                      0)
                  (store! j (+ (load j) 1)))
                (if (or (load clear)
                        (= (load i) (load (field v selected-island))))
                    (do
                      (text v a name (+ x 32.0) (+ y 5.0) 14.0 color)
                      (al/al-push! (mut occupied) bounds)
                      0)
                    0))
              0)
            0))
      (store! i (+ (load i) 1)))
    (r/EndScissorMode)
    (let [index
            (if (and (>= (load (field (field v folders) selected)) 0)
                     (< (load (field v selected-island)) 0))
                -1
                (context-island v w))]
      (if (and (>= index 0) (< index (al/al-len (load (field w islands)))))
          (let [island (al/al-get (load (field w islands)) index)]
            (r/DrawRectangle 212
                             126
                             (cast i32 (- (load (field v width)) 532))
                             30
                             (r/rgba 10 20 24 235))
            (text v
                  a
                  (load (field island name))
                  224.0
                  132.0
                  15.0
                  (r/rgba 255 195 108 255))
            0)
          0))
    0))

(defn context-island [(v (ptr View)) (w (ptr world/World))] (-> i64)
  (let [(mut best) (load (field v selected-island))
        (mut distance) 1.0e30
        (mut i) 0]
    (if (>= (load best) 0)
        0
        (loop (if (>= (load i) (al/al-len (load (field w islands))))
                  (break 0)
                  0)
          (let [island (al/al-get (load (field w islands)) (load i))
                d
                  (r/distance2 (load (field v target))
                               (load (field island position)))
                radius (load (field island radius))]
            (if (and (island-present? v (load i))
                     (< d (* radius radius))
                     (< d (load distance)))
                (do (store! best (load i)) (store! distance d))
                0))
          (store! i (+ (load i) 1))))
    (load best)))

(defn island-labels! [(v (ptr View))
                      (w (ptr world/World))
                      (snapshot (ptr m/Snapshot))
                      (a (dyn alloc/Allocator))] (-> i64)
  (block :labels
         (if (<= (load (field v zoom)) 15.0) (break :labels 0) 0)
         (let [islands (load (field w islands))
               viewport
                 (r/rect 210.0
                         135.0
                         (cast f64 (- (load (field v width)) 520))
                         (cast f64 (- (load (field v height)) 327)))
               (mut footprints) (al/al-new [r/Rectangle] a)
               (mut obstacles) (al/al-new [r/Rectangle] a)
               (mut i) 0]
           (al/al-push! (mut obstacles)
                        (r/rect (cast f64 (- (load (field v width)) 395))
                                85.0
                                90.0
                                115.0))
           (loop (if (>= (load i) (al/al-len islands)) (break 0) 0)
             (let [box (island-screen-bounds v (al/al-get islands (load i)))]
               (al/al-push! (mut footprints) box)
               (if (map-labels/overlaps? box viewport)
                   (map-labels/reserve-island! (mut obstacles)
                                               box
                                               (* (* 0.5
                                                     (cast f64
                                                           (load (field box
                                                                        width))))
                                                  (r/sin (load (field v pitch)))))
                   0))
             (store! i (+ (load i) 1)))
           (store! i 0)
           (loop (if (>= (load i) (al/al-len islands)) (break 0) 0)
             (let [island (al/al-get islands (load i))
                   footprint (al/al-get (load footprints) (load i))]
               (if (and (map-labels/overlaps? footprint viewport)
                        (>= (load (field footprint width)) 80.0))
                   (let [name (leaf-name (load (field island name)))
                         counts (m/island-census snapshot (load i))
                         first
                           (m/copy-text a
                                        (str/cstr->str (r/TextFormat c"%lld structs   %lld enums"
                                                                     (load (index counts
                                                                                  0))
                                                                     (load (index counts
                                                                                  1)))))
                         second
                           (m/copy-text a
                                        (str/cstr->str (r/TextFormat c"%lld maps   %lld trees"
                                                                     (load (index counts
                                                                                  2))
                                                                     (load (index counts
                                                                                  3)))))
                         third
                           (m/copy-text a
                                        (str/cstr->str (r/TextFormat c"%lld queues   %lld graphs   %lld fn"
                                                                     (load (index counts
                                                                                  4))
                                                                     (load (index counts
                                                                                  5))
                                                                     (load (index counts
                                                                                  6)))))
                         name-width (label-width v a name 14.0)
                         (mut width) name-width
                         (mut detailed)
                           (and (>= (load (field v width)) 1300)
                                (>= (load (field footprint width)) 180.0))]
                     (let [one (label-width v a first 10.0)
                           two (label-width v a second 10.0)
                           three (label-width v a third 10.0)]
                       (if (> one (load width)) (store! width one) 0)
                       (if (> two (load width)) (store! width two) 0)
                       (if (> three (load width)) (store! width three) 0))
                     (let [(mut placement)
                             (if (load detailed)
                                 (map-labels/place footprint
                                                   (load width)
                                                   70.0
                                                   viewport
                                                   (load obstacles))
                                 (None [r/Rectangle]))]
                       (match (load placement)
                         (Some [_] 0)
                         (None []
                               (do
                                 (store! detailed false)
                                 (store! placement
                                         (map-labels/place footprint
                                                           name-width
                                                           28.0
                                                           viewport
                                                           (load obstacles)))
                                 0)))
                       (match (load placement)
                         (None [] 0)
                         (Some [placed]
                               (let [box placed
                                     x (cast f64 (load (field box x)))
                                     y (cast f64 (load (field box y)))]
                                 ;; Keep neighboring backplates visually separate.
                                 (al/al-push! (mut obstacles)
                                              (r/rect (- x 4.0)
                                                      (- y 4.0)
                                                      (+ (cast f64
                                                               (load (field box
                                                                            width)))
                                                         8.0)
                                                      (+ (cast f64
                                                               (load (field box
                                                                            height)))
                                                         8.0)))
                                 (let [anchor (label-shore-anchor v island box)
                                       edge
                                         (r/v2 (r/clamp (cast f64
                                                              (load (field anchor
                                                                           x)))
                                                        x
                                                        (+ x
                                                           (cast f64
                                                                 (load (field box
                                                                              width)))))
                                               (r/clamp (cast f64
                                                              (load (field anchor
                                                                           y)))
                                                        y
                                                        (+ y
                                                           (cast f64
                                                                 (load (field box
                                                                              height))))))]
                                   (r/DrawLineEx anchor
                                                 edge
                                                 0.8
                                                 (r/rgba 119 149 154 155)))
                                 (r/DrawRectangleRec box (r/rgba 10 18 22 222))
                                 (r/DrawRectangle (cast i32 x)
                                                  (cast i32 (+ y 5.0))
                                                  2
                                                  (if (load detailed) 60 18)
                                                  (if (> (load (field island
                                                                      changed))
                                                         0)
                                                      (r/rgba 226 162 64 230)
                                                      (r/rgba 94 121 126 210)))
                                 (text v
                                       a
                                       name
                                       (+ x 8.0)
                                       (+ y 6.0)
                                       14.0
                                       (r/rgba 232 225 210 255))
                                 (if (load detailed)
                                     (do
                                       (text v
                                             a
                                             first
                                             (+ x 8.0)
                                             (+ y 27.0)
                                             10.0
                                             (r/rgba 151 174 179 255))
                                       (text v
                                             a
                                             second
                                             (+ x 8.0)
                                             (+ y 40.0)
                                             10.0
                                             (r/rgba 151 174 179 255))
                                       (text v
                                             a
                                             third
                                             (+ x 8.0)
                                             (+ y 53.0)
                                             10.0
                                             (r/rgba 151 174 179 255))
                                       0)
                                     0)
                                 0)))))
                   0))
             (store! i (+ (load i) 1)))
           0)))

(defn text [(v (ptr View))
            (a (dyn alloc/Allocator))
            (s (slice u8))
            (x f64)
            (y f64)
            (size f64)
            (c r/Color)] (-> i64)
  (r/DrawTextEx (load (field v font))
                (str/str->cstr a s)
                (r/v2 x y)
                (cast f32 size)
                0.5
                c)
  0)

(defn label [(v (ptr View))
             (a (dyn alloc/Allocator))
             (s (slice u8))
             (x f64)
             (y f64)] (-> i64)
  (text v a s x y 12.0 (r/rgba 130 151 157 255)))

(defn line [(x f64) (y f64) (xx f64) (yy f64)] (-> void)
  (r/DrawLineEx (r/v2 x y) (r/v2 xx yy) 1.0 (r/rgba 43 59 64 255)))

(defn number [(n i64)] (-> (slice u8))
  (str/cstr->str (r/TextFormat c"%lld" n)))

(defn leaf-name [(name (slice u8))] (-> (slice u8))
  (let [(mut i) 0
        (mut start) 0]
    (loop (if (>= (load i) (slice-len name)) (break 0) 0)
      (let [c (cast i64 (slice-get name (load i)))]
        (if (= c 47) (store! start (+ (load i) 1)) 0))
      (store! i (+ (load i) 1)))
    (subslice name (load start) (slice-len name))))

(defn legend-bounds [(width f64) (height f64)] (-> r/Rectangle)
  (r/rect (- width 766.0) (- height 172.0) 450.0 56.0))

(defn inside-panel? [(p r/Vector2) (panel r/Rectangle)] (-> bool)
  (let [x (cast f64 (load (field p x)))
        y (cast f64 (load (field p y)))
        left (cast f64 (load (field panel x)))
        top (cast f64 (load (field panel y)))]
    (and (>= x left)
         (< x (+ left (cast f64 (load (field panel width)))))
         (>= y top)
         (< y (+ top (cast f64 (load (field panel height))))))))

(defn source-bounds [(width f64) (height f64) (open bool)] (-> r/Rectangle)
  (let [size (if open 128.0 28.0)]
    (r/rect 218.0 (- (- height 184.0) size) (- width 540.0) size)))

;;; Transport buttons: previous, play/pause, next, slower, faster.
(defn transport-bounds [(width f64) (height f64) (index i64)] (-> r/Rectangle)
  (r/rect (cond (< index 3) (+ 18.0 (* (cast f64 index) 34.0))
                (= index 3) (- width 144.0)
                :else (- width 44.0))
          (- height 84.0)
          28.0
          28.0))

(defn transport-action [(width f64) (height f64) (mouse r/Vector2)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) 5) (break 0) 0)
      (if (inside-panel? mouse (transport-bounds width height (load i)))
          (break (+ (load i) 1))
          0)
      (store! i (+ (load i) 1)))))

;;; Wrap only at UTF-8 boundaries. A newline is consumed by the caller.
(defn source-row-end [(source (slice u8)) (start i64) (columns i64)] (-> i64)
  (let [(mut end) start
        (mut count) 0
        n (slice-len source)]
    (loop (if (or (>= (load end) n)
                  (>= (load count) columns)
                  (= (cast i64 (slice-get source (load end))) 10))
              (break 0)
              0)
      (store! end (+ (load end) 1))
      (loop (if (>= (load end) n) (break 0) 0)
        (if (!= (& (cast i64 (slice-get source (load end))) 192) 128)
            (break 0)
            0)
        (store! end (+ (load end) 1)))
      (store! count (+ (load count) 1)))
    (load end)))

;;; Prefer a word boundary within an already UTF-8-safe measured span.
(defn prose-break [(source (slice u8)) (start i64) (fit i64)] (-> i64)
  (if (or (>= fit (slice-len source))
          (<= (cast i64 (slice-get source fit)) 32))
      fit
      (let [(mut end) fit]
        (loop (if (<= (load end) start) (break fit) 0)
          (if (<= (cast i64 (slice-get source (- (load end) 1))) 32)
              (break (- (load end) 1))
              0)
          (store! end (- (load end) 1))))))

(defn prose! [(v (ptr View))
              (a (dyn alloc/Allocator))
              (source (slice u8))
              (x f64)
              (y f64)
              (width f64)
              (size f64)
              (rows i64)
              (color r/Color)] (-> i64)
  (let [(mut start) 0
        (mut row) 0
        n (slice-len source)]
    (loop (if (or (>= (load start) n) (>= (load row) rows)) (break 0) 0)
      (let [begin (load start)
            (mut fit) (load start)
            last (= (load row) (- rows 1))
            ellipsis
              (r/MeasureTextEx (load (field v font)) c"..." (cast f32 size) 0.5)
            available
              (- width
                 (if last (+ 0.5 (cast f64 (load (field ellipsis x)))) 0.0))]
        (loop (if (>= (load fit) n) (break 0) 0)
          (let [next (source-row-end source (load fit) 1)]
            (if (= next (load fit)) (break 0) 0)
            (let [measure
                    (r/MeasureTextEx (load (field v font))
                                     (str/str->cstr a
                                                    (subslice source
                                                              (load start)
                                                              next))
                                     (cast f32 size)
                                     0.5)]
              (if (> (cast f64 (load (field measure x))) available) (break 0) 0))
            (store! fit next)))
        (let [end (prose-break source (load start) (load fit))
              clipped (and last (< end n))
              content (subslice source (load start) end)]
          (text v
                a
                content
                x
                (+ y (* (cast f64 (load row)) (+ size 5.0)))
                size
                color)
          (if clipped
              (let [measure
                      (r/MeasureTextEx (load (field v font))
                                       (str/str->cstr a content)
                                       (cast f32 size)
                                       0.5)]
                (text v
                      a
                      "..."
                      (+ x (+ 0.5 (cast f64 (load (field measure x)))))
                      (+ y (* (cast f64 (load row)) (+ size 5.0)))
                      size
                      color))
              0)
          (store! start end)
          (loop (if (>= (load start) n) (break 0) 0)
            (if (> (cast i64 (slice-get source (load start))) 32) (break 0) 0)
            (store! start (+ (load start) 1)))
          ;; An oversized glyph cannot advance the fitted span; stop safely.
          (if (<= (load start) begin) (break 0) 0)))
      (store! row (+ (load row) 1)))
    0))

(defn source-pane [(v (ptr View))
                   (a (dyn alloc/Allocator))
                   (source (slice u8))
                   (missing bool)
                   (heading (slice u8))
                   (x f64)
                   (y f64)
                   (width f64)
                   (color r/Color)] (-> i64)
  (let [(mut start) 0
        (mut row) 0
        columns (cast i64 (r/clamp (/ width 8.2) 1.0 1000.0))
        n (slice-len source)]
    (text v a heading x y 11.0 color)
    (r/BeginScissorMode (cast i32 x)
                        (cast i32 (+ y 18.0))
                        (cast i32 width)
                        62)
    (if (or missing (= n 0))
        (text v
              a
              (if missing "Not present in this snapshot" "Source unavailable")
              x
              (+ y 20.0)
              14.0
              (r/rgba 132 151 156 255))
        0)
    (loop (if (or missing (>= (load start) n) (>= (load row) 3)) (break 0) 0)
      (let [end (source-row-end source (load start) columns)]
        (text v
              a
              (subslice source (load start) end)
              x
              (+ (+ y 20.0) (* (cast f64 (load row)) 19.0))
              14.0
              (r/rgba 196 203 185 255))
        (store! start
                (if (and (< end n) (= (cast i64 (slice-get source end)) 10))
                    (+ end 1)
                    end)))
      (store! row (+ (load row) 1)))
    (r/EndScissorMode)
    (if (and (not missing) (< (load start) n))
        (text v a "Excerpt continues..." x (+ y 81.0) 10.0 color)
        0)
    0))

(defn source-preview [(v (ptr View))
                      (a (dyn alloc/Allocator))
                      (entity m/Entity)] (-> i64)
  (let [width (- (cast f64 (load (field v width))) 540.0)
        open (load (field v source-open))
        bounds
          (source-bounds (cast f64 (load (field v width)))
                         (cast f64 (load (field v height)))
                         open)
        top (cast f64 (load (field bounds y)))
        state (load (field entity state))
        compare (and (load (field entity previous-known)) (!= state 0))
        pane-width (/ (- width 42.0) 2.0)]
    (r/DrawRectangle 218
                     (cast i32 top)
                     (cast i32 width)
                     (cast i32 (load (field bounds height)))
                     (r/rgba 10 18 22 242))
    (label v a (if open "SOURCE [V]  -" "SOURCE [V]  +") 232.0 (+ top 9.0))
    (r/BeginScissorMode 370 (cast i32 top) (cast i32 (- width 166.0)) 28)
    (label v a (load (field entity path)) 370.0 (+ top 9.0))
    (r/EndScissorMode)
    (if (not open)
        0
        (if compare
            (do
              (source-pane v
                           a
                           (load (field entity previous-source))
                           (= state 2)
                           "BEFORE"
                           232.0
                           (+ top 30.0)
                           pane-width
                           (r/rgba 231 135 124 255))
              (source-pane v
                           a
                           (load (field entity source))
                           (= state 3)
                           "AFTER"
                           (+ 246.0 pane-width)
                           (+ top 30.0)
                           pane-width
                           (r/rgba 131 217 192 255)))
            (source-pane v
                         a
                         (load (field entity source))
                         false
                         "SOURCE"
                         232.0
                         (+ top 30.0)
                         (- width 28.0)
                         (r/rgba 132 151 156 255))))
    0))

;;; Preserve HDR lighting through bloom/tone mapping, with sampleable depth
;;; for contact shading. UnloadRenderTexture releases both attachments.
(defn scene-target [(width i32) (height i32)] (-> r/RenderTexture)
  (let [id (r/rlLoadFramebuffer)
        color (r/rlLoadTexture (cast (ptr u8) 0) width height 13 1)
        depth (r/rlLoadTextureDepth width height (cast u8 0))]
    (if (or (= id (cast u32 0))
            (or (= color (cast u32 0)) (= depth (cast u32 0))))
        (do
          (r/rlUnloadTexture color)
          (r/rlUnloadTexture depth)
          (r/rlUnloadFramebuffer id)
          (alloc/abort)
          0)
        0)
    (r/rlFramebufferAttach id color 0 100 0)
    (r/rlFramebufferAttach id depth 100 100 0)
    (if (= (r/rlFramebufferComplete id) (cast u8 0))
        (do
          (r/rlUnloadTexture color)
          (r/rlUnloadFramebuffer id)
          (alloc/abort)
          0)
        0)
    (r/RenderTexture
      :id id
      :texture
        (r/Texture
          :id color
          :width width
          :height height
          :mipmaps 1
          :format 13)
      :depth
        (r/Texture
          :id depth
          :width width
          :height height
          :mipmaps 1
          :format 19))))

(defn new-view [(w (ptr world/World))] (-> View)
  (let [font-path c"/System/Library/Fonts/Supplemental/Arial.ttf"
        a (load (field (field w registry) alc))
        font
          (if (!= (r/FileExists font-path) (cast u8 0))
              (r/LoadFontEx font-path 32 (cast (ptr i32) 0) 0)
              (r/GetFontDefault))]
    (View
      :camera
        (r/Camera3D
          :position (r/v3 45.0 50.0 45.0)
          :target (r/v3 0.0 0.0 0.0)
          :up (r/v3 0.0 1.0 0.0)
          :fovy 72.0
          :projection 1)
      :target (r/v3 0.0 0.0 0.0)
      :yaw 0.65
      :pitch 0.72
      :zoom 56.0
      :desired-zoom 56.0
      :fit-zoom 56.0
      :cursor-zoom false
      :zoom-offset (r/v2 0.0 0.0)
      :selected -1
      :selected-island -1
      :loading-history false
      :pointer-down false
      :pointer-dragged false
      :pointer-origin (r/v2 0.0 0.0)
      :selected-member -1
      :member-owner 0
      :hovered -1
      :width 1600
      :height 1000
      :font font
      :bold font
      :texture (scene-target 2200 1648)
      :minimap (r/LoadRenderTexture 164 144)
      :minimap-dirty true
      :minimap-triangles (al/al-new [MiniTriangle] (alloc/malloc-allocator))
      :minimap-layout-count -1
      :projection (zeroed r/Matrix)
      :terrain (zeroed r/Model)
      :proxies (zeroed (array (al/ArrayList r/Matrix) 4))
      :proxy-model (proxy-mesh)
      :proxies-dirty true
      :proxies-selected -2
      :island-counts (al/al-new [i64] (alloc/malloc-allocator))
      :folders (folders/new-state)
      :folder-borders (al/al-new [r/Vector3] (alloc/malloc-allocator))
      :folder-layout-count -1
      :show-borders true
      :show-links false
      :revealed-island -1
      :town-hall (town/mesh)
      :town-coarse (town/coarse-mesh)
      :terrain-chunks
        (terrain/bake-chunks (load (field w islands)) (load (field w registry)))
      :water (zeroed r/Model)
      :ocean
        (r/LoadShaderFromMemory (str/str->cstr a
                                               (include-str "../assets/shaders/water.vs"))
                                (str/str->cstr a
                                               (include-str "../assets/shaders/water.fs")))
      :trees (glyph/bake-trees)
      :slabs (glyph/bake-slabs)
      :courtyards (glyph/bake-courtyards)
      :functions (glyph/bake-functions)
      :pick-bounds (glyph/pick-bounds-cache)
      :time 0.0
      :shadow-ms 0.0
      :world-ms 0.0
      :present-ms 0.0
      :terrain-ms 0.0
      :glyph-ms 0.0
      :water-ms 0.0
      :routes-ms 0.0
      :streets-ms 0.0
      :impact-selected -2
      :impact-distances (al/al-new [i64] (alloc/malloc-allocator))
      :impact-summary
        (impact/Summary
          :direct 0
          :indirect 0
          :available false)
      :speed 1.0
      :help false
      :source-open false
      :light
        (r/LoadShaderFromMemory (str/str->cstr a
                                               (include-str "../assets/shaders/world.vs"))
                                (str/str->cstr a
                                               (include-str "../assets/shaders/world.fs")))
      :depth
        (r/LoadShaderFromMemory (str/str->cstr a
                                               (include-str "../assets/shaders/world.vs"))
                                (str/str->cstr a
                                               (include-str "../assets/shaders/depth.fs")))
      :post
        (r/LoadShaderFromMemory (cast (ptr i8) 0)
                                (str/str->cstr a
                                               (include-str "../assets/shaders/post.fs")))
      :shadow (r/LoadRenderTexture 2048 2048)
      :mode 2
      :age 0.0
      :activity (r/v3 0.0 3.0 0.0)
      :activity-origin (r/v3 0.0 3.0 0.0)
      :activity-target (r/v3 0.0 3.0 0.0)
      :activity-known false
      :read-errors 0
      :repository-scroll 0.0
      :inspector-scroll 0.0
      :search (search/new-search a)
      :input-blocked false)))

(defn key-pressed? [(v (ptr View)) (key i32)] (-> bool)
  (and (not (load (field v input-blocked)))
       (!= (r/IsKeyPressed key) (cast u8 0))))

(defn key-down? [(v (ptr View)) (key i32)] (-> bool)
  (and (not (load (field v input-blocked))) (!= (r/IsKeyDown key) (cast u8 0))))

;;; Common text-input entry point for OS character events and Atlas replays.
(defn text-input! [(v (ptr View)) (code i64)] (-> i64)
  (if (load (field (field v search) active))
      (search/append-codepoint! (field v search) code)
      0))

(defn search-input! [(v (ptr View)) (snapshot (ptr m/Snapshot))] (-> bool)
  (let [s (field v search)
        mouse (r/GetMousePosition)
        x (cast f64 (load (field mouse x)))
        y (cast f64 (load (field mouse y)))
        clicked (!= (r/IsMouseButtonPressed 0) (cast u8 0))
        bar (and (>= x 218.0) (< x 568.0) (>= y 86.0) (< y 120.0))
        was-active (load (field s active))
        opening
          (and (not was-active)
               (or (!= (r/IsKeyPressed 47) (cast u8 0)) (and clicked bar)))]
    (if opening
        (do (store! (field s active) true) (store! (field s cursor) 0))
        0)
    (store! (field v input-blocked) (or was-active opening))
    (if (load (field s active))
        (do
          (loop (let [code (cast i64 (r/GetCharPressed))]
                  (if (= code 0) (break 0) 0)
                  (if (not opening) (text-input! v code) 0)))
          (if (or (!= (r/IsKeyPressed 259) (cast u8 0))
                  (!= (r/IsKeyPressedRepeat 259) (cast u8 0)))
              (search/backspace! s)
              0)
          (search/refresh! s snapshot)
          (let [count (al/al-len (load (field s results)))
                cursor (load (field s cursor))
                start (if (> cursor 7) (- cursor 7) 0)
                row (cast i64 (/ (- y 151.0) 42.0))
                choose
                  (and clicked
                       (>= x 218.0)
                       (< x 568.0)
                       (>= y 151.0)
                       (< row 8)
                       (< (+ start row) count))]
            (if (and (!= (r/IsKeyPressed 264) (cast u8 0))
                     (< (+ cursor 1) count))
                (store! (field s cursor) (+ cursor 1))
                0)
            (if (and (!= (r/IsKeyPressed 265) (cast u8 0)) (> cursor 0))
                (store! (field s cursor) (- cursor 1))
                0)
            (if choose (store! (field s cursor) (+ start row)) 0)
            (if (and (> count 0)
                     (or choose (!= (r/IsKeyPressed 257) (cast u8 0))))
                (let [at
                        (al/al-get (load (field s results))
                                   (load (field s cursor)))
                      e (al/al-get (load (field snapshot entities)) at)]
                  (store! (field v selected) at)
                  (store! (field v cursor-zoom) false)
                  (store! (field v target) (load (field e position)))
                  (store! (field v desired-zoom) 12.0)
                  (store! (field s active) false))
                0))
          0)
        0)
    (load (field v input-blocked))))

;;; Dismiss one inspection layer. Only an already-clear view requests exit.
(defn escape! [(v (ptr View))] (-> bool)
  (cond (load (field (field v search) active))
          (do (store! (field (field v search) active) false) false)
        (load (field v help)) (do (store! (field v help) false) false)
        (and (load (field v source-open))
             (>= (load (field v selected)) 0)
             (< (load (field v zoom)) 18.0))
          (do (store! (field v source-open) false) false)
        (and (>= (load (field v selected-member)) 0)
             (>= (load (field v selected)) 0)
             (<= (load (field v zoom)) 7.0))
          (do (store! (field v selected-member) -1) false)
        (>= (load (field v selected)) 0)
          (do
            (store! (field v selected) -1)
            (store! (field v selected-member) -1)
            (store! (field v member-owner) 0)
            (store! (field v inspector-scroll) 0.0)
            false)
        (>= (load (field v selected-island)) 0)
          (do
            (store! (field v selected-island) -1)
            (store! (field v inspector-scroll) 0.0)
            false)
        (and (>= (load (field (field v folders) selected)) 0)
             (> (al/al-len (load (field (field v folders) rows))) 0))
          (do (store! (field (field v folders) selected) -1) false)
        :else true))

(defn resize! [(v (ptr View))] (-> i64)
  (let [width (cast i64 (r/GetScreenWidth))
        height (cast i64 (r/GetScreenHeight))]
    (if (or (!= width (load (field v width)))
            (!= height (load (field v height))))
        (do
          (r/UnloadRenderTexture (load (field v texture)))
          (store! (field v cursor-zoom) false)
          (store! (field v texture)
                  (scene-target (cast i32 (* 2 (- width 500)))
                                (cast i32 (* 2 (- height 176)))))
          (store! (field v width) width)
          (store! (field v height) height))
        0)
    0))

(defn update-camera! [(v (ptr View))
                      (w (ptr world/World))
                      (snapshot (ptr m/Snapshot))
                      (dt f64)] (-> i64)
  (resize! v)
  (let [mouse (r/GetMousePosition)
        delta (r/GetMouseDelta)
        mx (cast f64 (load (field mouse x)))
        my (cast f64 (load (field mouse y)))
        source-visible
          (and (>= (load (field v selected)) 0)
               (< (load (field v selected))
                  (al/al-len (load (field snapshot entities))))
               (< (load (field v zoom)) 18.0))
        source-panel
          (source-bounds (cast f64 (load (field v width)))
                         (cast f64 (load (field v height)))
                         (load (field v source-open)))
        over
          (and (not (load (field v input-blocked)))
               (> mx 200.0)
               (< mx (- (cast f64 (load (field v width))) 300.0))
               (> my 76.0)
               (not (inside-panel? mouse
                                   (legend-bounds (cast f64
                                                        (load (field v width)))
                                                  (cast f64
                                                        (load (field v height))))))
               (not (and source-visible (inside-panel? mouse source-panel)))
               (< my (- (cast f64 (load (field v height))) 100.0)))
        yaw (load (field v yaw))
        zoom (load (field v zoom))]
    (if (and over (!= (r/IsMouseButtonPressed 0) (cast u8 0)))
        (do
          (store! (field v pointer-down) true)
          (store! (field v pointer-dragged) false)
          (store! (field v pointer-origin) mouse))
        0)
    (if (and (load (field v pointer-down))
             (!= (r/IsMouseButtonDown 0) (cast u8 0)))
        (let [origin (load (field v pointer-origin))
              dx (- mx (cast f64 (load (field origin x))))
              dy (- my (cast f64 (load (field origin y))))]
          (if (> (+ (* dx dx) (* dy dy)) 16.0)
              (store! (field v pointer-dragged) true)
              0))
        0)
    (if (and source-visible
             (not (load (field v input-blocked)))
             (or (key-pressed? v 86)
                 (and (!= (r/IsMouseButtonPressed 0) (cast u8 0))
                      (inside-panel? mouse source-panel)
                      (< my (+ (cast f64 (load (field source-panel y))) 28.0)))))
        (store! (field v source-open) (not (load (field v source-open))))
        0)
    (if (and (not (load (field v input-blocked)))
             (!= (r/IsMouseButtonPressed 0) (cast u8 0))
             (< my 65.0))
        (let [width (cast f64 (load (field v width)))]
          (cond (and (> mx (- width 675.0)) (< mx (- width 580.0)))
                  (store! (field v mode) 0)
                (and (> mx (- width 578.0)) (< mx (- width 449.0)))
                  (store! (field v mode) 1)
                (and (> mx (- width 445.0)) (< mx (- width 353.0)))
                  (store! (field v mode) 2)
                (and (> mx (- width 348.0)) (< mx (- width 260.0)))
                  (store! (field v mode) 3)
                :else 0))
        0)
    (if over
        (do
          (if (> (r/fabs (cast f64 (r/GetMouseWheelMove))) 0.00001)
              (do
                (store! (field v cursor-zoom) true)
                (store! (field v zoom-offset)
                        (r/v2 (- (- mx 200.0)
                                 (* 0.5
                                    (cast f64 (- (load (field v width)) 500))))
                              (- (- my 76.0)
                                 (* 0.5
                                    (cast f64 (- (load (field v height)) 176)))))))
              0)
          (store! (field v desired-zoom)
                  (r/clamp (* (load (field v desired-zoom))
                              (r/exp (* -0.12 (cast f64 (r/GetMouseWheelMove)))))
                           5.0
                           (if (> (* 2.0 (load (field v fit-zoom))) 250.0)
                               (* 2.0 (load (field v fit-zoom)))
                               250.0)))
          (if (!= (r/IsMouseButtonDown 1) (cast u8 0))
              (do
                (store! (field v cursor-zoom) false)
                (store! (field v yaw)
                        (- yaw (* 0.006 (cast f64 (load (field delta x))))))
                (store! (field v pitch)
                        (r/clamp (+ (load (field v pitch))
                                    (* 0.006 (cast f64 (load (field delta y)))))
                                 0.25
                                 1.45)))
              0))
        0)
    (let [forward
            (- (if (key-down? v 87) 1.0 0.0)
               (if (key-down? v 83) 1.0 0.0))
          side
            (- (if (key-down? v 68) 1.0 0.0)
               (if (key-down? v 65) 1.0 0.0))
          drag
            (or (and over (!= (r/IsMouseButtonDown 2) (cast u8 0)))
                (and (load (field v pointer-down))
                     (load (field v pointer-dragged))
                     (!= (r/IsMouseButtonDown 0) (cast u8 0))))
          keyboard
            (r/keyboard-distance side forward zoom dt (load (field v pitch)))
          travel
            (r/drag-distance delta
                             zoom
                             (cast f64 (- (load (field v height)) 176))
                             (load (field v pitch)))
          dx
            (+ (cast f64 (load (field keyboard x)))
               (if drag (cast f64 (load (field travel x))) 0.0))
          dz
            (+ (cast f64 (load (field keyboard y)))
               (if drag (cast f64 (load (field travel y))) 0.0))
          target (load (field v target))]
      (if (or drag (or (> (r/fabs side) 0.0) (> (r/fabs forward) 0.0)))
          (store! (field v cursor-zoom) false)
          0)
      (store! (field v target)
              (r/pan-target target yaw dx dz)))
    (if (key-pressed? v 72)
        (store! (field v help) (not (load (field v help))))
        0)
    (if (key-pressed? v 82)
        (do
          (store! (field v cursor-zoom) false)
          (store! (field v target) (r/v3 0.0 0.0 0.0))
          (store! (field v desired-zoom) 56.0)
          (store! (field v yaw) 0.65)
          (store! (field v pitch) 0.72))
        0)
    (store! (field v zoom)
            (r/mix zoom
                   (load (field v desired-zoom))
                   (- 1.0 (r/exp (* -12.0 dt)))))
    (if (load (field v cursor-zoom))
        (store! (field v target)
                (r/zoom-target (load (field v target))
                               (load (field v yaw))
                               (load (field v pitch))
                               zoom
                               (load (field v zoom))
                               (load (field v zoom-offset))
                               (cast f64 (- (load (field v height)) 176))))
        0)
    (let [target (load (field v target))
          yaw (load (field v yaw))
          pitch (load (field v pitch))]
      (store! (field v camera)
              (r/orbit-camera target yaw pitch (load (field v zoom)))))
    (store! (field v hovered) -1)
    (if over
        (let [ray
                (r/GetScreenToWorldRayEx (r/v2 (- mx 200.0) (- my 76.0))
                                         (load (field v camera))
                                         (cast i32
                                               (- (load (field v width)) 500))
                                         (cast i32
                                               (- (load (field v height)) 176)))
              (mut nearest) 100000.0
              (mut hovered-member) -1
              (mut i) 0]
          (loop (if (>= (load i) (al/al-len (load (field snapshot entities))))
                    (break 0)
                    0)
            (let [e (al/al-get (load (field snapshot entities)) (load i))
                  p (load (field e position))
                  exposed (member-cells? v snapshot (load i))
                  detail-hit
                    (if exposed
                        (glyph/member-hit ray
                                          p
                                          (m/member-count e))
                        (zeroed glyph/MemberHit))
                  hit
                    (if exposed
                        (load (field detail-hit collision))
                        (if (= (load (field e kind)) 0)
                            (r/GetRayCollisionBox ray
                                                  (glyph/struct-bounds p
                                                                       (glyph/struct-levels e)))
                            (let [kind (load (field e kind))
                                  index
                                    (if (= kind 3)
                                        (+ 7 (% (load (field e members)) 17))
                                        (if (and (>= kind 0) (<= kind 6))
                                            kind
                                            6))]
                              (r/GetRayCollisionBox ray
                                                    (glyph/translated-bounds (load (index (field v
                                                                                                 pick-bounds)
                                                                                          index))
                                                                             p)))))]
              (if (and (island-present? v (load (field e island)))
                       (!= (load (field hit hit)) (cast u8 0))
                       (< (cast f64 (load (field hit distance))) (load nearest)))
                  (do
                    (store! nearest (cast f64 (load (field hit distance))))
                    (store! hovered-member
                            (if exposed (load (field detail-hit index)) -1))
                    (store! (field v hovered) (load i)))
                  0))
            (store! i (+ (load i) 1)))
          (if (and (load (field v pointer-down))
                   (not (load (field v pointer-dragged)))
                   (!= (r/IsMouseButtonReleased 0) (cast u8 0)))
              (let [town (town-hit v w mouse)]
                (if (>= town 0)
                    (select-island! v w town false)
                    (do
                      (store! (field v selected) (load (field v hovered)))
                      (if (>= (load (field v selected)) 0)
                          (let [e
                                  (al/al-get (load (field snapshot entities))
                                             (load (field v selected)))]
                            (store! (field v selected-island)
                                    (load (field e island)))
                            (store! (field v inspector-scroll) 0.0)
                            (select-member! v e (load hovered-member)))
                          0))))
              0))
        0)
    (if (= (r/IsMouseButtonDown 0) (cast u8 0))
        (store! (field v pointer-down) false)
        0)
    (if (and (key-pressed? v 70)
             (>= (load (field v selected)) 0))
        (let [e
                (al/al-get (load (field snapshot entities))
                           (load (field v selected)))]
          (store! (field v cursor-zoom) false)
          (store! (field v target) (load (field e position)))
          (store! (field v desired-zoom) 12.0))
        0)
    (if (and (key-pressed? v 70)
             (< (load (field v selected)) 0)
             (>= (load (field v selected-island)) 0))
        (select-island! v w (load (field v selected-island)) true)
        0)
    0))

(defn changed-index [(snapshot (ptr m/Snapshot)) (row i64)] (-> i64)
  (let [(mut i) 0
        (mut n) 0
        entities (load (field snapshot entities))]
    (loop (if (>= (load i) (al/al-len entities)) (break -1) 0)
      (let [e (al/al-get entities (load i))]
        (if (!= (load (field e state)) 0)
            (do
              (if (= (load n) row) (break (load i)) 0)
              (store! n (+ (load n) 1)))
            0))
      (store! i (+ (load i) 1)))))

(defn inspector-height [(snapshot (ptr m/Snapshot))] (-> f64)
  (let [count
          (+ (count-state snapshot 1)
             (+ (count-state snapshot 2) (count-state snapshot 3)))]
    (if (> count 0) (+ 920.0 (* 44.0 (cast f64 count))) 900.0)))

(defn inspector-offset [(snapshot (ptr m/Snapshot)) (bottom f64) (offset f64)] (-> f64)
  (let [height (inspector-height snapshot)]
    (r/clamp offset 0.0 (if (> height bottom) (- height bottom) 0.0))))

(defn member-mode? [(v (ptr View)) (snapshot (ptr m/Snapshot))] (-> bool)
  (and (<= (load (field v zoom)) 7.0)
       (>= (load (field v selected)) 0)
       (< (load (field v selected))
          (al/al-len (load (field snapshot entities))))))

(defn member-cells? [(v (ptr View)) (snapshot (ptr m/Snapshot)) (index i64)] (-> bool)
  (and (= index (load (field v selected)))
       (member-mode? v snapshot)
       (let [e (al/al-get (load (field snapshot entities)) index)]
         (or (load (field e details-known))
             (> (m/member-count e) 0)))))

(defn active-member [(v (ptr View)) (entity m/Entity)] (-> i64)
  (let [index (load (field v selected-member))]
    (if (and (= (load (field v member-owner)) (load (field entity id)))
             (>= index 0)
             (< index (m/member-count entity)))
        index
        -1)))

(defn select-member! [(v (ptr View)) (entity m/Entity) (index i64)] (-> i64)
  (store! (field v member-owner) (load (field entity id)))
  (store! (field v selected-member)
          (if (and (>= index 0)
                   (< index (m/member-count entity)))
              index
              -1))
  0)

(defn inspector-height-for [(v (ptr View)) (snapshot (ptr m/Snapshot))] (-> f64)
  (if (>= (load (field v selected)) 0)
      (let [entity
              (al/al-get (load (field snapshot entities))
                         (load (field v selected)))
            count (m/member-count entity)]
        (if (> count 0)
            (+ 760.0 (* 80.0 (cast f64 count)))
            (+ 620.0
               (* 18.0
                  (cast f64 (source-row-count (load (field entity source))))))))
      (if (>= (load (field v selected-island)) 0)
          (+ 400.0
             (* 44.0
                (cast f64
                      (island-entity-count snapshot
                                           (load (field v selected-island))))))
          (if (and (>= (load (field (field v folders) selected)) 0)
                   (> (al/al-len (load (field (field v folders) rows))) 0))
              710.0
              (inspector-height snapshot)))))

(defn island-entity-count [(snapshot (ptr m/Snapshot)) (island i64)] (-> i64)
  (let [(mut count) 0
        (mut i) 0
        entities (load (field snapshot entities))]
    (loop (if (>= (load i) (al/al-len entities)) (break 0) 0)
      (let [e (al/al-get entities (load i))]
        (if (= (load (field e island)) island)
            (store! count (+ (load count) 1))
            0))
      (store! i (+ (load i) 1)))
    (load count)))

(defn island-entity-index [(snapshot (ptr m/Snapshot)) (island i64) (row i64)] (-> i64)
  (let [(mut count) 0
        (mut i) 0
        entities (load (field snapshot entities))]
    (loop (if (>= (load i) (al/al-len entities)) (break -1) 0)
      (let [e (al/al-get entities (load i))]
        (if (= (load (field e island)) island)
            (do
              (if (= row (load count)) (break (load i)) 0)
              (store! count (+ (load count) 1)))
            0))
      (store! i (+ (load i) 1)))))

(defn focused-inspector! [(v (ptr View))
                          (w (ptr world/World))
                          (snapshot (ptr m/Snapshot))
                          (a (dyn alloc/Allocator))
                          (right f64)
                          (bottom f64)] (-> i64)
  (let [entities (load (field snapshot entities))
        selected (load (field v selected))
        white (r/rgba 232 229 215 255)
        muted (r/rgba 143 167 170 255)
        amber (r/rgba 255 185 80 255)
        x (+ right 22.0)
        rev (load (field snapshot revision))]
    (label v
           a
           (if (>= selected 0) "STRUCTURE / FOCUS" "ISLAND / TOWN CENTER")
           x
           94.0)
    (if (and (>= selected 0) (< selected (al/al-len entities)))
        (let [e (al/al-get entities selected)]
          (prose! v a (load (field e name)) x 122.0 256.0 21.0 3 white)
          (text v a (kind-name (load (field e kind))) x 206.0 14.0 amber)
          (prose! v a (load (field e path)) x 238.0 256.0 13.0 3 muted)
          (text v
                a
                (str/cstr->str (r/TextFormat c"Line %lld" (load (field e line))))
                x
                302.0
                13.0
                white)
          (text v a (state-name (load (field e state))) x 330.0 15.0 amber)
          (prose! v a (load (field e module)) x 360.0 256.0 13.0 2 muted)
          (text v
                a
                (str/cstr->str (r/TextFormat c"%lld direct / %lld indirect dependents"
                                             (load (field (field v
                                                                 impact-summary)
                                                          direct))
                                             (load (field (field v
                                                                 impact-summary)
                                                          indirect))))
                x
                414.0
                12.0
                muted)
          (label v a "F: focus building   V: source" x 450.0)
          (prose! v a rev x 480.0 256.0 10.0 2 muted)
          (if (> (m/member-count e) 0)
              (member-list! v snapshot a right bottom)
              (declaration-source! v e a x bottom))
          0)
        (let [index (load (field v selected-island))]
          (if (and (>= index 0) (< index (al/al-len (load (field w islands)))))
              (let [island (al/al-get (load (field w islands)) index)
                    counts (m/island-census snapshot index)
                    (mut present) 0
                    (mut row) 0
                    (mut i) 0]
                (loop (if (>= (load i) 7) (break 0) 0)
                  (store! present
                          (+ (load present) (load (index counts (load i)))))
                  (store! i (+ (load i) 1)))
                (store! i 0)
                (prose! v
                        a
                        (load (field island name))
                        x
                        122.0
                        256.0
                        21.0
                        4
                        white)
                (text v
                      a
                      (str/cstr->str (r/TextFormat c"%lld present / %lld removed"
                                                   (load present)
                                                   (- (island-entity-count snapshot
                                                                           index)
                                                      (load present))))
                      x
                      238.0
                      14.0
                      amber)
                (prose! v a rev x 268.0 256.0 10.0 2 muted)
                (label v a "Timeline changes this island in place." x 308.0)
                (label v a "STRUCTURES / CLICK TO INSPECT" x 346.0)
                (loop (if (>= (load i) (al/al-len entities)) (break 0) 0)
                  (let [e (al/al-get entities (load i))
                        y (+ 380.0 (* 44.0 (cast f64 (load row))))]
                    (if (= (load (field e island)) index)
                        (do
                          (if (and (> (+ y 38.0)
                                      (+ 76.0 (load (field v inspector-scroll))))
                                   (< y
                                      (+ bottom
                                         (load (field v inspector-scroll)))))
                              (do
                                (text v
                                      a
                                      (load (field e name))
                                      x
                                      y
                                      14.0
                                      (if (= (load (field e state)) 0)
                                          white
                                          (glyph/glyph-color (load (field e
                                                                          state))
                                                             false)))
                                (text v
                                      a
                                      (kind-name (load (field e kind)))
                                      x
                                      (+ y 20.0)
                                      10.0
                                      muted))
                              0)
                          (store! row (+ (load row) 1)))
                        0))
                  (store! i (+ (load i) 1)))
                (if (= (load row) 0)
                    (label v a "No structures at this commit." x 380.0)
                    0)
                0)
              0)))
    0))

(defn state-name [(state i64)] (-> (slice u8))
  (cond (= state 1) "Modified in this commit"
        (= state 2) "Added in this commit"
        (= state 3) "Removed in this commit"
        :else "Unchanged in this commit"))

(defn source-row-count [(source (slice u8))] (-> i64)
  (let [(mut start) 0
        (mut count) 0
        n (slice-len source)]
    (loop (if (>= (load start) n) (break 0) 0)
      (let [end (source-row-end source (load start) 34)]
        (store! start
                (if (and (< end n) (= (cast i64 (slice-get source end)) 10))
                    (+ end 1)
                    end)))
      (store! count (+ (load count) 1)))
    (load count)))

(defn declaration-source! [(v (ptr View))
                           (entity m/Entity)
                           (a (dyn alloc/Allocator))
                           (x f64)
                           (bottom f64)] (-> i64)
  (label v a "DECLARATION SOURCE" x 541.0)
  (let [source (load (field entity source))
        n (slice-len source)
        (mut start) 0
        (mut row) 0]
    (loop (if (>= (load start) n) (break 0) 0)
      (let [end (source-row-end source (load start) 34)
            y (+ 576.0 (* 18.0 (cast f64 (load row))))]
        (if (and (> (+ y 18.0) (+ 76.0 (load (field v inspector-scroll))))
                 (< y (+ bottom (load (field v inspector-scroll)))))
            (text v
                  a
                  (subslice source (load start) end)
                  x
                  y
                  12.0
                  (r/rgba 206 217 202 255))
            0)
        (store! start
                (if (and (< end n) (= (cast i64 (slice-get source end)) 10))
                    (+ end 1)
                    end)))
      (store! row (+ (load row) 1)))
    (if (= n 0) (label v a "Source unavailable for this analyzer." x 576.0) 0))
  0)

(defn kind-name [(kind i64)] (-> (slice u8))
  (cond (= kind 0) "Struct"
        (= kind 1) "Enum"
        (= kind 2) "Map"
        (= kind 3) "Tree"
        (= kind 4) "Queue"
        (= kind 5) "Graph"
        :else "Function"))

(defn inspector-offset-for [(v (ptr View))
                            (snapshot (ptr m/Snapshot))
                            (bottom f64)
                            (offset f64)] (-> f64)
  (let [height (inspector-height-for v snapshot)]
    (r/clamp offset 0.0 (if (> height bottom) (- height bottom) 0.0))))

(defn member-list! [(v (ptr View))
                    (snapshot (ptr m/Snapshot))
                    (a (dyn alloc/Allocator))
                    (right f64)
                    (bottom f64)] (-> i64)
  (let [entity
          (al/al-get (load (field snapshot entities)) (load (field v selected)))
        count (m/member-count entity)
        (mut i) 0]
    (label v a "DECLARED FIELDS" (+ right 22.0) 541.0)
    (text v
          a
          (if (load (field entity details-known))
              "Click field or cell / V opens source"
              "Partial or unavailable / source syntax")
          (+ right 22.0)
          562.0
          11.0
          (r/rgba 130 151 157 255))
    (if (= count 0)
        (label v
               a
               (if (load (field entity details-known))
                   "No declared fields."
                   "No field metadata available.")
               (+ right 22.0)
               590.0)
        0)
    (loop (if (>= (load i) count) (break 0) 0)
      (let [detail (m/member-detail entity (load i))
            state (m/member-state entity (load i))
            y (+ 590.0 (* 80.0 (cast f64 (load i))))
            signature (load (field detail signature))
            name (load (field detail name))
            (mut start) 0
            (mut row) 0]
        (if (and (> (+ (- y (load (field v inspector-scroll))) 72.0) 76.0)
                 (< (- y (load (field v inspector-scroll))) bottom))
            (do
              (if (= (load i) (active-member v entity))
                  (do
                    (r/DrawRectangle (cast i32 (+ right 14.0))
                                     (cast i32 (- y 6.0))
                                     272
                                     74
                                     (r/rgba 25 48 53 255))
                    0)
                  0)
              (text v
                    a
                    (subslice name 0 (source-row-end name 0 25))
                    (+ right 22.0)
                    y
                    14.0
                    (cond (= state 1) (r/rgba 255 184 76 255)
                          (= state 2) (r/rgba 125 218 193 255)
                          (= state 3) (r/rgba 231 139 122 255)
                          :else (r/rgba 232 225 210 255)))
              (text v
                    a
                    (str/cstr->str (r/TextFormat c"L%lld"
                                                 (load (field detail line))))
                    (+ right 220.0)
                    (+ y 1.0)
                    10.0
                    (r/rgba 130 151 157 255))
              (loop (if (or (>= (load row) 2)
                            (>= (load start) (slice-len signature)))
                        (break 0)
                        0)
                (let [end (source-row-end signature (load start) 34)]
                  (text v
                        a
                        (subslice signature (load start) end)
                        (+ right 22.0)
                        (+ (+ y 21.0) (* 16.0 (cast f64 (load row))))
                        12.0
                        (r/rgba 152 176 177 255))
                  (store! start
                          (if (and (< end (slice-len signature))
                                   (= (cast i64 (slice-get signature end)) 10))
                              (+ end 1)
                              end)))
                (store! row (+ (load row) 1)))
              (text v
                    a
                    (cond (= state 1) "Modified field"
                          (= state 2) "Added field"
                          (= state 3) "Removed field / previous source"
                          (= state 4) "Comparison unavailable"
                          :else "Unchanged field")
                    (+ right 22.0)
                    (+ y 56.0)
                    10.0
                    (r/rgba 130 151 157 255))
              (if (< (load start) (slice-len signature))
                  (text v
                        a
                        "..."
                        (+ right 260.0)
                        (+ y 56.0)
                        10.0
                        (r/rgba 130 151 157 255))
                  0)
              0)
            0))
      (store! i (+ (load i) 1)))
    0))

(defn begin-change! [(v (ptr View)) (snapshot (ptr m/Snapshot))] (-> i64)
  (al/al-free! (field v island-counts))
  (store! (field v island-counts) (al/al-new [i64] (alloc/malloc-allocator)))
  (let [(mut i) 0
        entities (load (field snapshot entities))]
    (loop (if (>= (load i) (al/al-len entities)) (break 0) 0)
      (let [e (al/al-get entities (load i))
            island (load (field e island))]
        (if (and (>= island 0) (!= (load (field e state)) 3))
            (do
              (loop (if (> (al/al-len (load (field v island-counts))) island)
                        (break 0)
                        0)
                (al/al-push! (field v island-counts) 0))
              (let [count (al/al-elem [i64] (field v island-counts) island)]
                (store! count (+ (load count) 1)))
              0)
            0))
      (store! i (+ (load i) 1))))
  (store! (field v proxies-dirty) true)
  (store! (field v minimap-dirty) true)
  (store! (field v activity-origin) (load (field v activity)))
  (store! (field v activity-known) false)
  (store! (field v selected-member) -1)
  (store! (field v impact-selected) -2)
  (store! (field v age) 0.0)
  (let [entities (load (field snapshot entities))
        (mut i) 0]
    (loop (if (>= (load i) (al/al-len entities)) (break 0) 0)
      (let [e (al/al-get entities (load i))]
        (if (!= (load (field e state)) 0)
            (do
              (store! (field v activity-target) (load (field e position)))
              (store! (field v activity-known) true)
              (break 0))
            0))
      (store! i (+ (load i) 1)))
    0))

;;; The target is valid only for this snapshot, not an earlier transition.
(defn activity-visible? [(v (ptr View))] (-> bool)
  (and (load (field v activity-known)) (< (load (field v age)) 4.0)))

;;; Evaluate from transition time rather than integrating render frame time.
;;; Pausing, speed changes, and frame subdivision now share the same trajectory.
(defn activity-position [(v (ptr View))] (-> r/Vector3)
  (let [origin (load (field v activity-origin))
        target (load (field v activity-target))
        age (load (field v age))
        factor (- 1.0 (r/exp (* -5.0 (if (> age 0.0) age 0.0))))]
    (r/v3 (r/mix (cast f64 (load (field origin x)))
                 (cast f64 (load (field target x)))
                 factor)
          3.6
          (r/mix (cast f64 (load (field origin z)))
                 (cast f64 (load (field target z)))
                 factor))))

(defn count-state [(snapshot (ptr m/Snapshot)) (state i64)] (-> i64)
  (let [entities (load (field snapshot entities))
        (mut i) 0
        (mut total) 0]
    (loop (if (>= (load i) (al/al-len entities)) (break (load total)) 0)
      (let [e (al/al-get entities (load i))]
        (if (= (load (field e state)) state)
            (store! total (+ (load total) 1))
            0))
      (store! i (+ (load i) 1)))))

(defn mark-changes! [(w (ptr world/World)) (snapshot (ptr m/Snapshot))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (al/al-len (load (field w islands)))) (break 0) 0)
      (store! (field (al/al-elem [m/Island] (field w islands) (load i)) changed)
              0)
      (store! i (+ (load i) 1)))
    (store! i 0)
    (loop (if (>= (load i) (al/al-len (load (field snapshot entities))))
              (break 0)
              0)
      (let [e (al/al-get (load (field snapshot entities)) (load i))]
        (if (and (!= (load (field e state)) 0) (>= (load (field e island)) 0))
            (let [island
                    (al/al-elem [m/Island]
                                (field w islands)
                                (load (field e island)))]
              (store! (field island changed)
                      (+ (load (field island changed)) 1)))
            0))
      (store! i (+ (load i) 1)))
    0))

(defn path-point [(a r/Vector3) (b r/Vector3) (t f64)] (-> r/Vector3)
  (let [x (r/mix (cast f64 (load (field a x))) (cast f64 (load (field b x))) t)
        z (r/mix (cast f64 (load (field a z))) (cast f64 (load (field b z))) t)
        distance (r/sqrt (r/distance2 a b))
        u
          (r/clamp (* (/ distance 3.141592653589793)
                      (r/sin (* t 3.141592653589793)))
                   0.0
                   1.0)
        clearance (* u (* u (- 3.0 (* 2.0 u))))]
    (r/v3 (+ x (* 2.6 (r/sin (* t 6.2831853))))
          (+ 2.1 (+ (* 0.75 clearance) (* 0.3 (r/sin (* t 3.14159265)))))
          z)))

;;; Camera-facing ribbons stay legible while orbiting. Depth testing is retained
;;; so terrain and structures still occlude routes; additive halos do not write
;;; depth and therefore cannot hide subsequent geometry.
(defn route-ribbon [(a r/Vector3)
                    (b r/Vector3)
                    (eye r/Vector3)
                    (width f64)
                    (color r/Color)] (-> i64)
  (let [dx (- (cast f64 (load (field b x))) (cast f64 (load (field a x))))
        dy (- (cast f64 (load (field b y))) (cast f64 (load (field a y))))
        dz (- (cast f64 (load (field b z))) (cast f64 (load (field a z))))
        ex (cast f64 (load (field eye x)))
        ey (cast f64 (load (field eye y)))
        ez (cast f64 (load (field eye z)))
        nx (- (* dy ez) (* dz ey))
        ny (- (* dz ex) (* dx ez))
        nz (- (* dx ey) (* dy ex))
        length (r/sqrt (+ (* nx nx) (+ (* ny ny) (* nz nz))))]
    (if (> length 0.000001)
        (let [sx (* width (/ nx length))
              sy (* width (/ ny length))
              sz (* width (/ nz length))
              ax (cast f64 (load (field a x)))
              ay (cast f64 (load (field a y)))
              az (cast f64 (load (field a z)))
              bx (cast f64 (load (field b x)))
              by (cast f64 (load (field b y)))
              bz (cast f64 (load (field b z)))]
          (r/rlBegin 4)
          (glyph/quad (r/v3 (- ax sx) (- ay sy) (- az sz))
                      (r/v3 (+ ax sx) (+ ay sy) (+ az sz))
                      (r/v3 (+ bx sx) (+ by sy) (+ bz sz))
                      (r/v3 (- bx sx) (- by sy) (- bz sz))
                      color)
          (r/rlEnd)
          0)
        0)))

;;; Orthographic zoom is the vertical world span. Express route thickness and
;;; activity markers in logical screen pixels, independent of render supersampling.
(defn route-size [(zoom f64) (viewport-height f64) (pixels f64)] (-> f64)
  (* (/ zoom (if (> viewport-height 0.0) viewport-height 1.0)) pixels))

;;; For smoothstep(clamp(k*sin(pi*t))), |y''| is bounded by
;;; 6*(k*pi)^2 + 1.5*k*pi^2. The clamped join has a continuous first
;;; derivative. Adding the lateral sine bound bounds the vector curvature.
;;; Linear interpolation error is at most M/(8*n*n), including any camera
;;; projection (orthographic projection cannot increase world-space error).
(defn route-segments [(distance f64)
                      (zoom f64)
                      (viewport-height f64)
                      (module-route bool)] (-> i64)
  (let [pi 3.141592653589793
        k (/ distance (if module-route pi 3.0))
        vertical
          (* (if module-route 0.75 1.0)
             (* (* pi pi) (+ (* 6.0 (* k k)) (* 1.5 k))))
        lateral
          (* (* pi pi)
             (if module-route 10.7 (r/clamp (* distance 0.06) 0.0 0.5)))
        tolerance (route-size zoom viewport-height 0.20)
        count
          (cast i64
                (r/ceil (r/sqrt (/ (+ vertical lateral)
                                   (* 8.0 tolerance)))))]
    (if (< count 24) 24 count)))

(defstruct RouteSampling [(edge f64) (ends i64) (middle i64)])

;;; Split at the two smoothstep saturation joins. High curvature exists only
;;; near the endpoints; the central interval needs only the sine-bend bound.
;;; Each interval retains the same analytic 0.20-pixel interpolation bound.
(defn route-sampling [(distance f64)
                      (zoom f64)
                      (height f64)
                      (module-route bool)] (-> RouteSampling)
  (let [pi 3.141592653589793
        k (/ distance (if module-route pi 3.0))
        edge (if (> k 1.0) (/ (r/asin (/ 1.0 k)) pi) 0.5)
        vertical
          (* (if module-route 0.75 1.0)
             (* (* pi pi) (+ (* 6.0 (* k k)) (* 1.5 k))))
        lateral
          (* (* pi pi)
             (if module-route 10.7 (r/clamp (* distance 0.06) 0.0 0.5)))
        denominator (* 8.0 (route-size zoom height 0.20))
        ends
          (cast i64
                (r/ceil (* edge (r/sqrt (/ (+ vertical lateral) denominator)))))
        middle
          (cast i64
                (r/ceil (* (- 1.0 (* 2.0 edge))
                           (r/sqrt (/ lateral denominator)))))]
    (RouteSampling
      :edge edge
      :ends (if (< ends 1) 1 ends)
      :middle (if (< middle 1) 1 middle))))

(defn route-count [(sampling RouteSampling)] (-> i64)
  (+ (* 2 (load (field sampling ends))) (load (field sampling middle))))

(defn route-parameter [(sampling RouteSampling) (index i64)] (-> f64)
  (let [edge (load (field sampling edge))
        ends (load (field sampling ends))
        middle (load (field sampling middle))]
    (cond (<= index ends) (* edge (/ (cast f64 index) (cast f64 ends)))
          (<= index (+ ends middle))
            (+ edge
               (* (- 1.0 (* 2.0 edge))
                  (/ (cast f64 (- index ends)) (cast f64 middle))))
          :else
            (+ (- 1.0 edge)
               (* edge (/ (cast f64 (- (- index ends) middle)) (cast f64 ends)))))))

(defn routes [(v (ptr View))
              (w (ptr world/World))
              (snapshot (ptr m/Snapshot))
              (time f64)
              (camera r/Camera3D)
              (zoom f64)
              (viewport-height f64)] (-> i64)
  (let [edges (load (field snapshot routes))
        position (load (field camera position))
        target (load (field camera target))
        eye
          (r/v3 (- (cast f64 (load (field position x)))
                   (cast f64 (load (field target x))))
                (- (cast f64 (load (field position y)))
                   (cast f64 (load (field target y))))
                (- (cast f64 (load (field position z)))
                   (cast f64 (load (field target z)))))
        width (route-size zoom viewport-height 0.55)
        (mut i) 0]
    (r/BeginBlendMode 1)
    (r/rlDisableDepthMask)
    (loop (if (>= (load i) (al/al-len edges)) (break 0) 0)
      (let [e (al/al-get edges (load i))
            from (load (field e source))
            to (load (field e target))]
        (if (and (>= from 0)
                 (>= to 0)
                 (!= from to)
                 (island-present? v from)
                 (island-present? v to))
            (let [aa (al/al-get (load (field w islands)) from)
                  bb (al/al-get (load (field w islands)) to)
                  a (load (field aa position))
                  b (load (field bb position))
                  sampling
                    (route-sampling (r/sqrt (r/distance2 a b))
                                    zoom
                                    viewport-height
                                    true)
                  segments (route-count sampling)
                  active
                    (or (> (load (field aa changed)) 0)
                        (> (load (field bb changed)) 0))
                  phase (+ (* time 0.15) (* (cast f64 (load i)) 0.17))
                  head (- phase (r/floor phase))
                  (mut j) 0]
              (if (or (position-visible? v a (+ 8.0 (load (field aa radius))))
                      (position-visible? v b (+ 8.0 (load (field bb radius)))))
                  (do
                    (loop (if (>= (load j) segments) (break 0) 0)
                      (let [t (route-parameter sampling (load j))
                            p (path-point a b t)
                            q
                              (path-point a
                                          b
                                          (route-parameter sampling
                                                           (+ (load j) 1)))
                            behind (- head t)
                            trail
                              (if (and (>= behind 0.0) (< behind 0.20))
                                  (- 1.0 (/ behind 0.20))
                                  0.0)]
                        (if active
                            (do
                              (route-ribbon p
                                            q
                                            eye
                                            (* width 5.0)
                                            (r/rgba 255 132 30 16))
                              (route-ribbon p
                                            q
                                            eye
                                            (* width 2.4)
                                            (r/rgba 255 163 48 36))
                              (route-ribbon p
                                            q
                                            eye
                                            width
                                            (r/rgba 244 169 65 155))
                              (if (> trail 0.0)
                                  (route-ribbon p
                                                q
                                                eye
                                                (* width 1.4)
                                                (r/rgba 255
                                                        216
                                                        139
                                                        (cast i64
                                                              (* 210.0 trail))))
                                  0))
                            (route-ribbon p
                                          q
                                          eye
                                          (* width 0.45)
                                          (r/rgba 67 99 103 75))))
                      (store! j (+ (load j) 1)))
                    (let [t head]
                      (if active
                          (do
                            (r/DrawSphereEx (path-point a b t)
                                            (cast f32
                                                  (route-size zoom
                                                              viewport-height
                                                              1.7))
                                            5
                                            8
                                            (r/rgba 255 196 95 255))
                            0)
                          0))
                    0)
                  0))
            0))
      (store! i (+ (load i) 1)))
    (r/EndBlendMode)
    (r/rlEnableDepthMask)
    0))

;;; Declaration references use raised ribbons rather than fixed-height street
;;; lines. Endpoints remain at foundations; the middle clears plateau relief.
(defn reference-point [(a r/Vector3) (b r/Vector3) (t f64)] (-> r/Vector3)
  (let [dx (- (cast f64 (load (field b x))) (cast f64 (load (field a x))))
        dz (- (cast f64 (load (field b z))) (cast f64 (load (field a z))))
        distance (r/sqrt (+ (* dx dx) (* dz dz)))
        edge-distance (* distance (* 0.5 (r/sin (* t 3.141592653589793))))
        u (r/clamp (/ edge-distance 1.5) 0.0 1.0)
        lift (* u (* u (- 3.0 (* 2.0 u))))
        bend
          (* (r/clamp (* distance 0.06) 0.0 0.5)
             (r/sin (* t 3.141592653589793)))
        inverse (if (> distance 0.00001) (/ 1.0 distance) 0.0)]
    (r/v3 (+ (r/mix (cast f64 (load (field a x)))
                    (cast f64 (load (field b x)))
                    t)
             (* (- 0.0 dz) (* inverse bend)))
          (+ 2.04 (* 1.0 lift))
          (+ (r/mix (cast f64 (load (field a z)))
                    (cast f64 (load (field b z)))
                    t)
             (* dx (* inverse bend))))))

(defn reference-link [(a r/Vector3)
                      (b r/Vector3)
                      (eye r/Vector3)
                      (zoom f64)
                      (viewport-height f64)
                      (time f64)
                      (active bool)
                      (selected bool)] (-> i64)
  (let [width (route-size zoom viewport-height 0.45)
        color (if active (r/rgba 225 163 77 210) (r/rgba 141 152 132 125))
        sampling
          (route-sampling (r/sqrt (r/distance2 a b))
                          zoom
                          viewport-height
                          false)
        segments (route-count sampling)
        head (- (* time 0.30) (r/floor (* time 0.30)))
        (mut i) 0]
    (loop (if (>= (load i) segments) (break 0) 0)
      (let [t (route-parameter sampling (load i))
            p (reference-point a b t)
            q
              (reference-point a
                               b
                               (route-parameter sampling (+ (load i) 1)))
            trail (- head t)
            wrapped (if (< trail 0.0) (+ trail 1.0) trail)]
        (if active
            (route-ribbon p q eye (* width 2.6) (r/rgba 245 157 53 24))
            0)
        (route-ribbon p q eye (* width (if selected 1.35 0.75)) color)
        (if (and active (< wrapped 0.14))
            (route-ribbon p
                          q
                          eye
                          (* width 1.25)
                          (r/rgba 255
                                  222
                                  158
                                  (cast i64 (* 230.0 (- 1.0 (/ wrapped 0.14))))))
            0))
      (store! i (+ (load i) 1)))
    0))

(defn streets [(v (ptr View)) (snapshot (ptr m/Snapshot))] (-> i64)
  (let [graph (load (field snapshot impact))
        entities (load (field snapshot entities))
        camera (load (field v camera))
        eye
          (glyph/vector-add (load (field camera position))
                            (glyph/vector-scale (load (field camera target))
                                                -1.0))
        (mut i) 0]
    (r/rlDrawRenderBatchActive)
    (r/rlDisableDepthMask)
    ;; Resolution is immutable snapshot data. Reuse the analyzer's indexed
    ;; graph instead of repeating two linear name/id searches per reference.
    (loop (if (>= (load i) (al/al-len (load (field graph heads)))) (break 0) 0)
      (let [target (al/al-get entities (load i))
            (mut link-index) (al/al-get (load (field graph heads)) (load i))]
        (loop (if (< (load link-index) 0) (break 0) 0)
          (let [link (al/al-get (load (field graph links)) (load link-index))
                source (load (field link source))
                from (al/al-get entities source)
                selected
                  (or (= source (load (field v selected)))
                      (= (load i) (load (field v selected))))
                changed
                  (or (!= (load (field from state)) 0)
                      (!= (load (field target state)) 0))]
            ;; At system scale import routes convey connectivity; declaration
            ;; ribbons become readable at building scale, or when selected.
            (if (and (island-present? v (load (field from island)))
                     (island-present? v (load (field target island)))
                     (or selected
                         (>= (route-size 1.4
                                         (load (field v zoom))
                                         (cast f64
                                               (- (load (field v height)) 176)))
                             8.0))
                     (or (position-visible? v (load (field from position)) 4.0)
                         (position-visible? v
                                            (load (field target position))
                                            4.0)))
                (reference-link (load (field from position))
                                (load (field target position))
                                eye
                                (load (field v zoom))
                                (cast f64 (- (load (field v height)) 176))
                                (load (field v time))
                                (or selected changed)
                                selected)
                0)
            (store! link-index (load (field link next))))))
      (store! i (+ (load i) 1)))
    (r/rlDrawRenderBatchActive)
    (r/rlEnableDepthMask)
    0))

(defn float-uniform! [(shader r/Shader) (loc i32) (data (ptr f32)) (kind i32)] (-> i64)
  (if (>= loc (cast i32 0))
      (do (r/SetShaderValue shader loc (cast (ptr u8) data) kind) 0)
      0))

(defn material! [(shader r/Shader) (value f32)] (-> i64)
  (let [loc (r/GetShaderLocation shader c"terrainMaterial")
        (mut parameter) value]
    (float-uniform! shader loc parameter 0)))

(defn terrain-model! [(v (ptr View)) (model r/Model) (shader r/Shader)] (-> i64)
  (store! (field (index (load (field model materials)) 0) shader)
          shader)
  (let [material (index (load (field model materials)) 0)
        shadow (load (field v shadow))
        loc (r/GetShaderLocation shader c"shadowMap")]
    (if (>= loc (cast i32 0))
        (do
          (store! (index (load (field shader locs)) 16) loc)
          (store! (field (index (load (field material maps)) 1) texture)
                  (load (field shadow texture))))
        0))
  (material! shader (cast f32 1.0))
  (r/DrawModel model
               (r/v3 0.0 0.0 0.0)
               1.0
               (r/rgba 255 255 255 255))
  0)

(defn terrain-geometry [(v (ptr View)) (shader r/Shader)] (-> i64)
  (let [started (r/GetTime)
        chunks (load (field v terrain-chunks))
        (mut i) 0]
    (if (> (load (field (field v terrain) meshCount)) 0)
        (terrain-model! v (load (field v terrain)) shader)
        0)
    (loop (if (>= (load i) (al/al-len chunks)) (break 0) 0)
      (let [chunk (al/al-get chunks (load i))
            island (load (field chunk island))
            coarse
              (> (/ (load (field v zoom))
                    (cast f64 (- (load (field v height)) 176)))
                 0.20)]
        (if (and (island-present? v (load i))
                 (position-visible? v
                                    (load (field island position))
                                    (+ (* 1.7 (load (field island radius))) 8.0)))
            (terrain-model! v
                            (if coarse
                                (load (field chunk coarse))
                                (load (field chunk fine)))
                            shader)
            0))
      (store! i (+ (load i) 1)))
    (store! (field v terrain-ms) (* 1000.0 (- (r/GetTime) started)))
    0))

(defn proxy-mode? [(v (ptr View))] (-> bool)
  (< (/ (* 1.4 (cast f64 (- (load (field v height)) 176)))
        (load (field v zoom)))
     8.0))

(defn proxy-mesh [] (-> r/Model)
  (let [(mut vertices) (al/al-new [terrain/Vertex] (alloc/malloc-allocator))]
    (glyph/box-into 0.0
                    0.0
                    0.0
                    1.0
                    1.0
                    1.0
                    (r/rgba 255 255 255 255)
                    (mut vertices))
    (let [model (terrain/upload (load vertices))]
      (al/al-free! (mut vertices))
      model)))

(defn unload-proxies! [(v (ptr View))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) 4) (break 0) 0)
      (al/al-free! (index (field v proxies) (load i)))
      (store! (index (field v proxies) (load i))
              (zeroed (al/ArrayList r/Matrix)))
      (store! i (+ (load i) 1)))
    0))

(defn prepare-proxies! [(v (ptr View)) (snapshot (ptr m/Snapshot))] (-> i64)
  (if (and (proxy-mode? v)
           (or (load (field v proxies-dirty))
               (!= (load (field v proxies-selected)) (load (field v selected)))))
      (let [entities (load (field snapshot entities))
            (mut state) 0
            (mut i) 0]
        (loop (if (>= (load state) 4) (break 0) 0)
          (let [list (index (field v proxies) (load state))]
            (if (= (load (field list cap)) 0)
                (store! list (al/al-new [r/Matrix] (alloc/malloc-allocator)))
                (al/al-clear! list)))
          (store! state (+ (load state) 1)))
        (loop (if (>= (load i) (al/al-len entities)) (break 0) 0)
          (let [e (al/al-get entities (load i))
                p (load (field e position))
                state (load (field e state))
                height
                  (if (= (load (field e kind)) 0)
                      (* 0.18 (cast f64 (glyph/struct-levels e)))
                      0.8)]
            (if (and (island-present? v (load (field e island)))
                     (>= state 0)
                     (< state 4)
                     (!= (load i) (load (field v selected))))
                (al/al-push! (index (field v proxies) state)
                             (instances/transform (cast f64 (load (field p x)))
                                                  (+ 1.99 (* height 0.5))
                                                  (cast f64 (load (field p z)))
                                                  1.2
                                                  height
                                                  1.1))
                0))
          (store! i (+ (load i) 1)))
        (store! (field v proxies-dirty) false)
        (store! (field v proxies-selected) (load (field v selected)))
        0)
      0))

(defn entity-detail? [(v (ptr View)) (index i64)] (-> bool)
  (or (= index (load (field v selected)))
      (>= (/ (* 1.4 (cast f64 (- (load (field v height)) 176)))
             (load (field v zoom)))
          8.0)))

;;; Conservative orthographic sphere test. Padding includes the tallest glyph
;;; and its ground shadow, so a caster immediately outside the view is retained.
(defn position-visible? [(v (ptr View)) (position r/Vector3) (radius f64)] (-> bool)
  (let [target (load (field v target))
        x
          (- (cast f64 (load (field position x)))
             (cast f64 (load (field target x))))
        y
          (- (cast f64 (load (field position y)))
             (cast f64 (load (field target y))))
        z
          (- (cast f64 (load (field position z)))
             (cast f64 (load (field target z))))
        yaw (load (field v yaw))
        pitch (load (field v pitch))
        sx (- (* x (r/cos yaw)) (* z (r/sin yaw)))
        sy
          (- (* (+ (* x (r/sin yaw)) (* z (r/cos yaw))) (r/sin pitch))
             (* y (r/cos pitch)))
        half (* 0.5 (load (field v zoom)))
        aspect
          (/ (cast f64 (- (load (field v width)) 500))
             (cast f64 (- (load (field v height)) 176)))]
    (and (<= (r/fabs sx) (+ (* half aspect) radius))
         (<= (r/fabs sy) (+ half radius)))))

(defn entity-proxy! [(entity m/Entity) (wire bool)] (-> i64)
  (let [position (load (field entity position))
        height
          (if (= (load (field entity kind)) 0)
              (* 0.18 (cast f64 (glyph/struct-levels entity)))
              0.8)]
    (glyph/block-shape (cast f64 (load (field position x)))
                       (+ 1.99 (* height 0.5))
                       (cast f64 (load (field position z)))
                       1.2
                       height
                       1.1
                       (glyph/glyph-color (load (field entity state)) false)
                       wire)))

(defn town-geometry! [(v (ptr View)) (shader r/Shader)] (-> i64)
  (let [(mut i) 0
        (mut clip) (cast f32 10000.0)
        (mut blueprint) (cast f32 0.0)
        (mut transforms) (al/al-new [r/Matrix] (alloc/malloc-allocator))
        (mut distant) (al/al-new [r/Matrix] (alloc/malloc-allocator))
        chunks (load (field v terrain-chunks))]
    (material! shader (cast f32 0.0))
    (float-uniform! shader (r/GetShaderLocation shader c"clipHeight") clip 0)
    (float-uniform! shader
                    (r/GetShaderLocation shader c"blueprint")
                    blueprint
                    0)
    (loop (if (>= (load i) (al/al-len chunks)) (break 0) 0)
      (let [chunk (al/al-get chunks (load i))
            island (load (field chunk island))
            count (island-population v (load i))
            p (town-point island)
            s (town/scale-for count)]
        (if (and (island-present? v (load i))
                 (position-visible? v p 10.0))
            (if (= (load i) (load (field v selected-island)))
                (glyph/cached-model-scaled (load (field v town-hall))
                                           p
                                           s
                                           (r/rgba 255 224 162 255)
                                           shader
                                           (load (field (field v shadow)
                                                        texture)))
                (let [matrix
                        (instances/transform (cast f64 (load (field p x)))
                                             (- 1.99 (* 1.99 s))
                                             (cast f64 (load (field p z)))
                                             s
                                             s
                                             s)]
                  (if (> (/ (* (* 3.4 s)
                               (cast f64 (- (load (field v height)) 176)))
                            (load (field v zoom)))
                         32.0)
                      (al/al-push! (mut transforms) matrix)
                      (al/al-push! (mut distant) matrix))))
            0))
      (store! i (+ (load i) 1)))
    (instances/draw! (load (field v town-hall))
                     (load transforms)
                     (r/rgba 255 255 255 255)
                     shader
                     (load (field (field v shadow) texture)))
    (al/al-free! (mut transforms))
    (instances/draw! (load (field v town-coarse))
                     (load distant)
                     (r/rgba 255 255 255 255)
                     shader
                     (load (field (field v shadow) texture)))
    (al/al-free! (mut distant))
    0))

(defn geometry [(v (ptr View)) (snapshot (ptr m/Snapshot)) (shader r/Shader)] (-> i64)
  (let [started (r/GetTime)]
    (terrain-geometry v shader)
    (town-geometry! v shader)
    ;; Batch by change state, not by entity. Uniform changes occur only after the
    ;; preceding batch is flushed. Ghost cages never enter the shadow pass.
    (let [(mut pass) 0
          entities (load (field snapshot entities))
          depth (load (field v depth))
          shadow-pass (= (load (field shader id)) (load (field depth id)))
          age (load (field v age))]
      (loop (if (>= (load pass) (if shadow-pass 4 6)) (break 0) 0)
        (let [wire (>= (load pass) 4)
              state (if wire (- (load pass) 2) (load pass))
              (mut clip)
                (cast f32 (if wire 10000.0 (animation/clip-height state age)))
              (mut blueprint) (cast f32 (if wire 1.0 0.0))
              (mut i) 0]
          (if (or (not wire) (animation/blueprint? state age))
              (do
                (r/BeginShaderMode shader)
                (material! shader (cast f32 0.0))
                (float-uniform! shader
                                (r/GetShaderLocation shader c"clipHeight")
                                clip
                                0)
                (float-uniform! shader
                                (r/GetShaderLocation shader c"blueprint")
                                blueprint
                                0)
                (let [shadow (load (field v shadow))
                      loc (r/GetShaderLocation shader c"shadowMap")]
                  (if (>= loc (cast i32 0))
                      (do
                        (r/SetShaderValueTexture shader
                                                 loc
                                                 (load (field shadow texture)))
                        0)
                      0))
                (loop (if (>= (load i) (al/al-len entities)) (break 0) 0)
                  (let [e (al/al-get entities (load i))]
                    (if (and (island-present? v (load (field e island)))
                             (= (load (field e state)) state)
                             (position-visible? v (load (field e position)) 8.0))
                        (if (not (entity-detail? v (load i)))
                            (if wire (entity-proxy! e wire) 0)
                            (if (member-cells? v snapshot (load i))
                                (glyph/member-body (load (field e position))
                                                   e
                                                   state
                                                   (if shadow-pass
                                                       -1
                                                       (active-member v e))
                                                   wire
                                                   shadow-pass
                                                   shader)
                                (glyph/draw e
                                            state
                                            (or (= (load i)
                                                   (load (field v selected)))
                                                (= (load i)
                                                   (load (field v hovered))))
                                            wire
                                            (load (field v time)))))
                        0))
                  (store! i (+ (load i) 1)))
                ;; Finish immediate foundations/cores before cached meshes.
                ;; Interleaving the two paths forces a batch flush per building.
                (r/rlDrawRenderBatchActive)
                (store! i 0)
                (if (and (not wire) (proxy-mode? v))
                    (instances/draw! (load (field v proxy-model))
                                     (load (index (field v proxies) state))
                                     (glyph/glyph-color state false)
                                     shader
                                     (load (field (field v shadow) texture)))
                    0)
                (if (not wire)
                    (do
                      (loop (if (>= (load i) (al/al-len entities)) (break 0) 0)
                        (let [e (al/al-get entities (load i))
                              kind (load (field e kind))
                              members (load (field e members))
                              selected
                                (or (= (load i) (load (field v selected)))
                                    (= (load i) (load (field v hovered))))]
                          (if (and (island-present? v (load (field e island)))
                                   (= (load (field e state)) state)
                                   (entity-detail? v (load i))
                                   (position-visible? v
                                                      (load (field e position))
                                                      8.0)
                                   (not (member-cells? v snapshot (load i)))
                                   (or (= kind 6)
                                       (or (= kind 0)
                                           (or (= kind 2) (= kind 3)))))
                              (glyph/cached-model (if (= kind 6)
                                                      (load (index (field v
                                                                          functions)
                                                                   (if (and (= state
                                                                               0)
                                                                            selected)
                                                                       4
                                                                       state)))
                                                      (if (= kind 2)
                                                          (load (index (field v
                                                                              courtyards)
                                                                       (if (and (= state
                                                                                   0)
                                                                                selected)
                                                                           4
                                                                           state)))
                                                          (if (= kind 3)
                                                              (load (index (field v
                                                                                  trees)
                                                                           (% members
                                                                              17)))
                                                              (load (index (field v
                                                                                  slabs)
                                                                           (glyph/slab-cache-index (glyph/struct-levels e)
                                                                                                   state
                                                                                                   selected))))))
                                                  (load (field e position))
                                                  (if (= kind 3)
                                                      (glyph/tree-color state
                                                                        selected)
                                                      (r/rgba 255 255 255 255))
                                                  shader
                                                  (load (field (field v shadow)
                                                               texture)))
                              0))
                        (store! i (+ (load i) 1)))
                      0)
                    0)
                (r/EndShaderMode)
                0)
              0))
        (store! pass (+ (load pass) 1))))
    (store! (field v glyph-ms)
            (- (* 1000.0 (- (r/GetTime) started)) (load (field v terrain-ms))))
    0))

(defn update-impact! [(v (ptr View)) (snapshot (ptr m/Snapshot))] (-> i64)
  (let [selected (load (field v selected))]
    (if (!= selected (load (field v impact-selected)))
        (do
          (al/al-free! (field v impact-distances))
          (store! (field v impact-distances)
                  (al/al-new [i64] (alloc/malloc-allocator)))
          (store! (field v impact-summary)
                  (impact/summarize-into (field snapshot impact)
                                         snapshot
                                         selected
                                         (field v impact-distances)))
          (store! (field v impact-selected) selected))
        0))
  0)

(defn dependent-markers! [(v (ptr View)) (snapshot (ptr m/Snapshot))] (-> i64)
  (let [distances (load (field v impact-distances))
        entities (load (field snapshot entities))
        width
          (r/clamp (/ (* (load (field v zoom)) 1.4)
                      (cast f64 (- (load (field v height)) 176)))
                   0.012
                   0.14)
        (mut i) 0]
    (if (and (or (= (load (field v mode)) 1) (= (load (field v mode)) 2))
             (= (al/al-len distances) (al/al-len entities)))
        (do
          (r/rlDrawRenderBatchActive)
          (r/rlDisableDepthMask)
          (loop (if (>= (load i) (al/al-len distances)) (break 0) 0)
            (let [distance (al/al-get distances (load i))
                  e (al/al-get entities (load i))]
              (if (and (> distance 0)
                       (island-present? v (load (field e island))))
                  (glyph/dependent-ring (load (field e position))
                                        distance
                                        width)
                  0))
            (store! i (+ (load i) 1)))
          (r/rlDrawRenderBatchActive)
          (r/rlEnableDepthMask)
          0)
        0))
  0)

(defn landmark-bounds [(v (ptr View)) (group overview/Group) (island m/Island)] (-> r/BoundingBox)
  (let [kind (load (field group kind))]
    (if (= kind 0)
        (glyph/struct-bounds (r/v3 0.0 1.99 0.0) (overview/levels group))
        (load (index (field v pick-bounds)
                     (if (= kind 3)
                         (+ 7 (% (load (field island seed)) 17))
                         kind))))))

;;; Render aggregates directly as symbols; never manufacture source entities.
;;; The caller supplies terrain prepared for the landmark footprints.
(defn landmark-geometry [(v (ptr View))
                         (w (ptr world/World))
                         (groups (ptr overview/Overview))
                         (shader r/Shader)] (-> i64)
  (let [started (r/GetTime)
        depth (load (field v depth))
        shadow-pass (= (load (field shader id)) (load (field depth id)))
        (mut i) 0]
    (terrain-geometry v shader)
    (r/BeginShaderMode shader)
    (material! shader (cast f32 0.0))
    (loop (if (>= (load i) (al/al-len (load (field groups groups))))
              (break 0)
              0)
      (let [group (al/al-get (load (field groups groups)) (load i))]
        (if (> (load (field group total)) 0)
            (let [kind (load (field group kind))
                  island
                    (al/al-get (load (field w islands))
                               (load (field group island)))
                  state (overview/state group)
                  levels (overview/levels group)
                  variant (% (load (field island seed)) 17)
                  local (landmark-bounds v group island)
                  anchor (overview/anchor island kind)
                  scale (overview/scale island kind local)
                  (mut pass) 0]
              (loop (if (>= (load pass) (if shadow-pass 1 2)) (break 0) 0)
                (let [wire (= (load pass) 1)
                      (mut clip)
                        (cast f32
                              (if wire
                                  10000.0
                                  (+ 1.99
                                     (* scale
                                        (- (animation/clip-height state
                                                                  (load (field v
                                                                               age)))
                                           1.99)))))
                      (mut blueprint) (cast f32 (if wire 1.0 0.0))]
                  (if (or (not wire)
                          (animation/blueprint? state (load (field v age))))
                      (do
                        (r/rlDrawRenderBatchActive)
                        (float-uniform! shader
                                        (r/GetShaderLocation shader
                                                             c"clipHeight")
                                        (mut clip)
                                        0)
                        (float-uniform! shader
                                        (r/GetShaderLocation shader
                                                             c"blueprint")
                                        (mut blueprint)
                                        0)
                        (let [shadow-loc
                                (r/GetShaderLocation shader c"shadowMap")]
                          (if (>= shadow-loc (cast i32 0))
                              (do
                                (r/SetShaderValueTexture shader
                                                         shadow-loc
                                                         (load (field (field v
                                                                             shadow)
                                                                      texture)))
                                0)
                              0))
                        (glyph/draw-symbol-scaled anchor
                                                  scale
                                                  kind
                                                  variant
                                                  levels
                                                  state
                                                  false
                                                  wire
                                                  (load (field v time)))
                        (if (and (not wire)
                                 (or (= kind 0)
                                     (= kind 2)
                                     (= kind 3)
                                     (= kind 6)))
                            (glyph/cached-model-scaled (cond (= kind 0)
                                                               (load (index (field v
                                                                                   slabs)
                                                                            (glyph/slab-cache-index levels
                                                                                                    state
                                                                                                    false)))
                                                             (= kind 2)
                                                               (load (index (field v
                                                                                   courtyards)
                                                                            state))
                                                             (= kind 3)
                                                               (load (index (field v
                                                                                   trees)
                                                                            variant))
                                                             :else
                                                               (load (index (field v
                                                                                   functions)
                                                                            state)))
                                                       anchor
                                                       scale
                                                       (if (= kind 3)
                                                           (glyph/tree-color state
                                                                             false)
                                                           (r/rgba 255
                                                                   255
                                                                   255
                                                                   255))
                                                       shader
                                                       (load (field (field v
                                                                           shadow)
                                                                    texture)))
                            0))
                      0))
                (store! pass (+ (load pass) 1))))
            0))
      (store! i (+ (load i) 1)))
    (r/EndShaderMode)
    (store! (field v glyph-ms)
            (- (* 1000.0 (- (r/GetTime) started)) (load (field v terrain-ms))))
    0))

(defn scene [(v (ptr View)) (w (ptr world/World)) (snapshot (ptr m/Snapshot))] (-> i64)
  (scene-with-overview v w snapshot (cast (ptr overview/Overview) 0)))

(defn scene-with-overview [(v (ptr View))
                           (w (ptr world/World))
                           (snapshot (ptr m/Snapshot))
                           (groups (ptr overview/Overview))] (-> i64)
  (update-impact! v snapshot)
  (prepare-proxies! v snapshot)
  (mark-changes! w snapshot)
  (r/rlSetClipPlanes 0.01
                     (if (> (* (load (field v zoom)) 8.0) 1000.0)
                         (* (load (field v zoom)) 8.0)
                         1000.0))
  (let [started (r/GetTime)
        target (load (field v target))
        light-distance
          (if (> (load (field v zoom)) 68.0) (/ (load (field v zoom)) 68.0) 1.0)
        sun
          (r/Camera3D
            :position
              (r/v3 (- (cast f64 (load (field target x)))
                       (* 60.0 light-distance))
                    (+ (cast f64 (load (field target y)))
                       (* 100.0 light-distance))
                    (- (cast f64 (load (field target z)))
                       (* 70.0 light-distance)))
            :target target
            :up (r/v3 0.0 1.0 0.0)
            :fovy (cast f32 (* 1.8 (load (field v zoom))))
            :projection 1)
        (mut light-vp) (zeroed r/Matrix)
        (mut stage-start) 0.0]
    (r/BeginTextureMode (load (field v shadow)))
    (r/ClearBackground (r/rgba 255 255 255 255))
    (r/BeginMode3D sun)
    (store! light-vp
            (r/matrix-multiply (r/rlGetMatrixProjection)
                               (r/rlGetMatrixModelview)))
    (if (= (cast i64 groups) 0)
        (geometry v snapshot (load (field v depth)))
        (landmark-geometry v w groups (load (field v depth))))
    (r/EndMode3D)
    (r/EndTextureMode)
    (store! (field v shadow-ms) (* 1000.0 (- (r/GetTime) started)))
    (let [shader (load (field v light))
          shadow (load (field v shadow))
          camera (load (field v camera))
          eye (load (field camera position))
          aim (load (field camera target))
          (mut direction)
            (r/v3 (- (cast f64 (load (field eye x)))
                     (cast f64 (load (field aim x))))
                  (- (cast f64 (load (field eye y)))
                     (cast f64 (load (field aim y))))
                  (- (cast f64 (load (field eye z)))
                     (cast f64 (load (field aim z)))))]
      (float-uniform! shader
                      (r/GetShaderLocation shader c"viewDirection")
                      (field direction x)
                      2)
      (float-uniform! (load (field v ocean))
                      (r/GetShaderLocation (load (field v ocean)) c"waterEye")
                      (field direction x)
                      2)
      (r/SetShaderValueMatrix shader
                              (r/GetShaderLocation shader c"lightVP")
                              (load light-vp))
      (r/SetShaderValueTexture shader
                               (r/GetShaderLocation shader c"shadowMap")
                               (load (field shadow texture))))
    (r/BeginTextureMode (load (field v texture)))
    (r/ClearBackground (r/rgba 12 28 34 255))
    (r/BeginMode3D (load (field v camera)))
    (store! (field v projection) (r/rlGetMatrixProjection))
    (store! stage-start (r/GetTime))
    (let [shader (load (field v ocean))
          (mut clock) (cast f32 (load (field v time)))]
      (float-uniform! shader (r/GetShaderLocation shader c"waterTime") clock 0)
      (if (> (load (field (field v water) meshCount)) 0)
          (store! (field (index (load (field (field v water) materials)) 0)
                         shader)
                  shader)
          0)
      (r/BeginShaderMode shader))
    ;; Cover the ground-plane intersection of the current orthographic view,
    ;; including large repositories far from the world origin.
    (let [target (load (field v target))
          aspect
            (/ (cast f64 (- (load (field v width)) 500))
               (cast f64 (- (load (field v height)) 176)))
          span
            (* (* 1.5 (load (field v zoom)))
               (+ aspect (/ 1.0 (r/sin (load (field v pitch))))))]
      (r/DrawPlane (r/v3 (cast f64 (load (field target x)))
                         -0.48
                         (cast f64 (load (field target z))))
                   (r/v2 span span)
                   (r/rgba 12 28 34 255)))
    (r/rlDrawRenderBatchActive)
    (r/rlDisableDepthMask)
    (if (> (load (field (field v water) meshCount)) 0)
        (do
          (r/DrawModel (load (field v water))
                       (r/v3 0.0 0.0 0.0)
                       1.0
                       (r/rgba 255 255 255 255))
          0)
        0)
    (let [(mut i) 0
          chunks (load (field v terrain-chunks))
          shader (load (field v ocean))]
      (loop (if (>= (load i) (al/al-len chunks)) (break 0) 0)
        (let [chunk (al/al-get chunks (load i))
              model (load (field chunk water))
              island (load (field chunk island))]
          (if (and (island-present? v (load i))
                   (position-visible? v
                                      (load (field island position))
                                      (* 2.1 (load (field island radius)))))
              (do
                (store! (field (index (load (field model materials)) 0) shader)
                        shader)
                (r/DrawModel model
                             (r/v3 0.0 0.0 0.0)
                             1.0
                             (r/rgba 255 255 255 255))
                0)
              0))
        (store! i (+ (load i) 1))))
    (r/rlDrawRenderBatchActive)
    (r/rlEnableDepthMask)
    (r/EndShaderMode)
    (store! (field v water-ms) (* 1000.0 (- (r/GetTime) (load stage-start))))
    (if (= (cast i64 groups) 0)
        (do
          (geometry v snapshot (load (field v light)))
          (store! stage-start (r/GetTime))
          (if (load (field v show-links)) (streets v snapshot) 0)
          (store! (field v streets-ms)
                  (* 1000.0 (- (r/GetTime) (load stage-start))))
          (dependent-markers! v snapshot))
        (landmark-geometry v w groups (load (field v light))))
    (store! stage-start (r/GetTime))
    (if (and (load (field v show-links)) (!= (load (field v mode)) 0))
        (routes v
                w
                snapshot
                (load (field v time))
                (load (field v camera))
                (load (field v zoom))
                (cast f64 (- (load (field v height)) 176)))
        0)
    (store! (field v routes-ms) (* 1000.0 (- (r/GetTime) (load stage-start))))
    (if (and (= (cast i64 groups) 0) (activity-visible? v))
        (let [target (load (field v activity-target))
              next (activity-position v)]
          (store! (field v activity) next)
          (r/DrawSphereEx next
                          (cast f32
                                (route-size (load (field v zoom))
                                            (cast f64
                                                  (- (load (field v height))
                                                     176))
                                            2.4))
                          6
                          10
                          (r/rgba 255 193 82 255))
          (glyph/ring target
                      (+ 1.0 (* (load (field v age)) 1.3))
                      (r/rgba 224
                              161
                              70
                              (cast i64
                                    (* 150.0
                                       (- 1.0 (/ (load (field v age)) 4.0)))))))
        0)
    (territories! v w)
    (r/EndMode3D)
    (r/EndTextureMode)
    (store! (field v world-ms)
            (- (* 1000.0 (- (r/GetTime) started)) (load (field v shadow-ms))))
    0))

(defn search-ui! [(v (ptr View))
                  (snapshot (ptr m/Snapshot))
                  (a (dyn alloc/Allocator))] (-> i64)
  (let [s (field v search)
        active (load (field s active))
        query (search/query-text s)
        measured
          (r/MeasureTextEx (load (field v font))
                           (str/str->cstr a query)
                           14.0
                           0.5)
        query-width (cast f64 (load (field measured x)))
        offset (if (> query-width 308.0) (- query-width 308.0) 0.0)]
    (r/DrawRectangle 218 86 350 34 (r/rgba 13 23 28 247))
    (r/DrawRectangleLinesEx (r/rect 218.0 86.0 350.0 34.0)
                            1.0
                            (if active
                                (r/rgba 196 142 65 255)
                                (r/rgba 52 72 77 255)))
    (r/BeginScissorMode 230 92 324 24)
    (text v
          a
          (if active query "Search structures or paths...   /")
          (if active (- 232.0 offset) 232.0)
          96.0
          14.0
          (r/rgba 205 213 206 255))
    (if (and active (< (% (cast i64 (* (r/GetTime) 2.0)) 2) 1))
        (do
          (r/DrawRectangle (cast i32 (+ (- 234.0 offset) query-width))
                           95
                           1
                           16
                           (r/rgba 230 201 146 255))
          0)
        0)
    (r/EndScissorMode)
    (if active
        (do
          (search/refresh! s snapshot)
          (let [results (load (field s results))
                count (al/al-len results)
                cursor (load (field s cursor))
                start (if (> cursor 7) (- cursor 7) 0)
                rows (if (< count 8) count 8)
                (mut row) 0]
            (r/DrawRectangle 218
                             120
                             350
                             (cast i32 (+ 67 (* rows 42)))
                             (r/rgba 10 19 24 250))
            (text v
                  a
                  (str/cstr->str (r/TextFormat c"%lld results / arrows choose / Enter focus"
                                               count))
                  232.0
                  130.0
                  11.0
                  (r/rgba 137 157 163 255))
            (loop (if (>= (load row) rows) (break 0) 0)
              (let [at (+ start (load row))
                    entity
                      (al/al-get (load (field snapshot entities))
                                 (al/al-get results at))
                    y (+ 151.0 (* (cast f64 (load row)) 42.0))]
                (if (= at cursor)
                    (do
                      (r/DrawRectangle 222
                                       (cast i32 y)
                                       342
                                       40
                                       (r/rgba 44 52 49 255))
                      0)
                    0)
                (r/BeginScissorMode 232 (cast i32 y) 320 40)
                (text v
                      a
                      (load (field entity name))
                      232.0
                      (+ y 3.0)
                      15.0
                      (if (= (load (field entity state)) 3)
                          (r/rgba 218 136 120 255)
                          (r/rgba 232 226 209 255)))
                (text v
                      a
                      (load (field entity path))
                      232.0
                      (+ y 23.0)
                      11.0
                      (r/rgba 136 158 166 255))
                (r/EndScissorMode))
              (store! row (+ (load row) 1)))
            (text v
                  a
                  (if (= count 0)
                      "No matches. Esc closes search."
                      "Esc closes / coral indicates a removal ghost")
                  232.0
                  (+ 160.0 (* (cast f64 rows) 42.0))
                  11.0
                  (r/rgba 137 157 163 255))))
        0)
    0))

(defn compass-ui! [(v (ptr View)) (a (dyn alloc/Allocator))] (-> i64)
  (let [x (- (cast f64 (load (field v width))) 347.0)
        y 129.0
        (mut i) 0]
    (r/DrawCircle (cast i32 x) (cast i32 y) 39.0 (r/rgba 10 20 25 220))
    (loop (if (>= (load i) 4) (break 0) 0)
      (let [direction
              (r/compass-direction (load (field v yaw))
                                   (load (field v pitch))
                                   (* (cast f64 (load i)) 1.5707963267948966))
            dx (cast f64 (load (field direction x)))
            dy (cast f64 (load (field direction y)))
            color
              (if (= (load i) 0)
                  (r/rgba 232 225 207 255)
                  (r/rgba 105 131 137 255))]
        (r/DrawLineEx (r/v2 (+ x (* dx 5.0)) (+ y (* dy 5.0)))
                      (r/v2 (+ x (* dx 23.0)) (+ y (* dy 23.0)))
                      (if (= (load i) 0) 2.0 1.0)
                      color)
        (text v
              a
              (cond (= (load i) 0) "N"
                    (= (load i) 1) "E"
                    (= (load i) 2) "S"
                    :else "W")
              (- (+ x (* dx 32.0)) 3.5)
              (- (+ y (* dy 32.0)) 5.0)
              10.0
              color))
      (store! i (+ (load i) 1)))
    0))

(defn legend-ui! [(v (ptr View)) (a (dyn alloc/Allocator))] (-> i64)
  (let [bounds
          (legend-bounds (cast f64 (load (field v width)))
                         (cast f64 (load (field v height))))
        left (cast f64 (load (field bounds x)))
        top (cast f64 (load (field bounds y)))
        (mut i) 0]
    (r/DrawRectangleRec bounds (r/rgba 10 18 22 248))
    (r/DrawRectangleLinesEx bounds 1.0 (r/rgba 48 67 70 190))
    (loop (if (>= (load i) 6) (break 0) 0)
      (let [x (+ left (+ 13.0 (* (cast f64 (% (load i) 3)) 148.0)))
            y (+ top (+ 14.0 (* (cast f64 (/ (load i) 3)) 25.0)))
            color
              (cond (= (load i) 0) (r/rgba 255 184 76 255)
                    (= (load i) 1) (r/rgba 131 217 192 255)
                    (= (load i) 2) (r/rgba 231 136 124 255)
                    (= (load i) 3) (r/rgba 113 119 113 255)
                    (= (load i) 4) (r/rgba 231 226 213 255)
                    :else (r/rgba 141 152 132 255))
            name
              (cond (= (load i) 0) "Modified"
                    (= (load i) 1) "Added"
                    (= (load i) 2) "Removed"
                    (= (load i) 3) "Unchanged"
                    (= (load i) 4) "Selected"
                    :else "Dependency")]
        (cond (= (load i) 4)
                (do (r/DrawCircleLines (cast i32 x) (cast i32 y) 4.0 color) 0)
              (= (load i) 5)
                (do
                  (r/DrawLineEx (r/v2 (- x 5.0) y) (r/v2 (+ x 6.0) y) 1.0 color)
                  0)
              :else (do (r/DrawCircleV (r/v2 x y) 3.5 color) 0))
        (text v a name (+ x 13.0) (- y 6.0) 11.0 (r/rgba 184 197 195 255)))
      (store! i (+ (load i) 1))))
  0)

(defn minimap-entities! [(v (ptr View))
                         (snapshot (ptr m/Snapshot))
                         (frame r/Vector3)
                         (center r/Vector2)] (-> i64)
  (let [(mut i) 0
        amber (r/rgba 255 184 76 255)]
    (let [entities (load (field snapshot entities))
          (mut pass) 0]
      (loop (if (>= (load pass) 2) (break 0) 0)
        (store! i 0)
        (loop (if (>= (load i) (al/al-len entities)) (break 0) 0)
          (let [e (al/al-get entities (load i))
                state (load (field e state))
                selected false]
            (if (and (island-present? v (load (field e island)))
                     (= (if (or selected (!= state 0)) 1 0) (load pass)))
                (do
                  (r/DrawCircleV (tactical/project (load (field e position))
                                                   frame
                                                   center)
                                 (if selected 2.5 (if (= state 0) 0.7 1.4))
                                 (if selected
                                     (r/rgba 247 238 207 255)
                                     (cond (= state 1) amber
                                           (= state 2) (r/rgba 131 217 192 255)
                                           (= state 3) (r/rgba 231 136 124 255)
                                           :else (r/rgba 156 167 150 190))))
                  0)
                0))
          (store! i (+ (load i) 1)))
        (store! pass (+ (load pass) 1))))
    0))

(defn prepare-minimap-layout! [(v (ptr View)) (w (ptr world/World))] (-> i64)
  (let [count (al/al-len (load (field w registry)))]
    (if (!= count (load (field v minimap-layout-count)))
        (let [(mut i) 0
              islands (load (field w islands))
              frame (world/map-frame w)
              center (r/v2 82.0 72.0)]
          (al/al-clear! (field v minimap-triangles))
          (loop (if (>= (load i) (al/al-len islands)) (break 0) 0)
            (let [island (al/al-get islands (load i))
                  p
                    (tactical/project (load (field island position))
                                      frame
                                      center)
                  (mut layer) 0]
              (loop (if (>= (load layer) 3) (break 0) 0)
                (let [size
                        (cond (= (load layer) 0) 1.27
                              (= (load layer) 1) (land/coast-scale)
                              :else (land/plateau-scale))
                      color
                        (cond (= (load layer) 0) (r/rgba 24 48 53 255)
                              (= (load layer) 1) (r/rgba 76 79 65 255)
                              :else (r/rgba 47 61 51 255))
                      (mut segment) 0]
                  (loop (if (>= (load segment) 64) (break 0) 0)
                    (let [a
                            (tactical/project (terrain/ring-point island
                                                                  (* (cast f64
                                                                           (load segment))
                                                                     (/ 6.283185307179586
                                                                        64.0))
                                                                  size
                                                                  0.0)
                                              frame
                                              center)
                          b
                            (tactical/project (terrain/ring-point island
                                                                  (* (cast f64
                                                                           (+ (load segment)
                                                                              1))
                                                                     (/ 6.283185307179586
                                                                        64.0))
                                                                  size
                                                                  0.0)
                                              frame
                                              center)]
                      (al/al-push! (field v minimap-triangles)
                                   (MiniTriangle
                                     :island (load i)
                                     :a p
                                     :b b
                                     :c a
                                     :color color)))
                    (store! segment (+ (load segment) 1))))
                (store! layer (+ (load layer) 1))))
            (store! i (+ (load i) 1)))
          (store! (field v minimap-layout-count) count)
          0)
        0)))

(defn update-minimap! [(v (ptr View))
                       (w (ptr world/World))
                       (snapshot (ptr m/Snapshot))] (-> i64)
  (if (load (field v minimap-dirty))
      (let [(mut i) 0
            islands (load (field w islands))
            frame (world/map-frame w)
            center (r/v2 82.0 72.0)]
        (prepare-minimap-layout! v w)
        (r/BeginTextureMode (load (field v minimap)))
        (r/ClearBackground (r/rgba 14 29 34 255))
        (let [triangles (load (field v minimap-triangles))]
          (loop (if (>= (load i) (al/al-len triangles)) (break 0) 0)
            (let [t (al/al-get triangles (load i))]
              (if (island-present? v (load (field t island)))
                  (do
                    (r/DrawTriangle (load (field t a))
                                    (load (field t b))
                                    (load (field t c))
                                    (load (field t color)))
                    0)
                  0))
            (store! i (+ (load i) 1))))
        (minimap-entities! v snapshot frame center)
        (r/EndTextureMode)
        (store! (field v minimap-dirty) false)
        0)
      0))

(defn ui [(v (ptr View))
          (w (ptr world/World))
          (snapshot (ptr m/Snapshot))
          (a (dyn alloc/Allocator))
          (revisions (al/ArrayList m/Revision))
          (current i64)
          (playing bool)] (-> i64)
  (let [started (r/GetTime)
        width (cast f64 (load (field v width)))
        height (cast f64 (load (field v height)))
        right (- width 300.0)
        bottom (- height 100.0)
        white (r/rgba 231 226 213 255)
        amber (r/rgba 255 184 76 255)
        muted (r/rgba 126 147 153 255)
        target (load (field v texture))]
    (update-minimap! v w snapshot)
    (r/BeginDrawing)
    (r/ClearBackground (r/rgba 11 17 21 255))
    (r/BeginShaderMode (load (field v post)))
    (let [shader (load (field v post))
          projection (load (field v projection))
          (mut coefficients) (zeroed r/Vector4)]
      (store! coefficients
              (r/Vector4
                :x (load (field projection m0))
                :y (load (field projection m5))
                :z (load (field projection m10))
                :w (load (field projection m14))))
      (r/SetShaderValueTexture shader
                               (r/GetShaderLocation shader c"sceneDepth")
                               (load (field target depth)))
      (float-uniform! shader
                      (r/GetShaderLocation shader c"projection")
                      (field coefficients x)
                      3))
    (r/SetTextureFilter (load (field target texture)) 1)
    (r/DrawTexturePro (load (field target texture))
                      (r/rect 0.0
                              0.0
                              (* 2.0 (- width 500.0))
                              (* 2.0 (- 176.0 height)))
                      (r/rect 200.0 76.0 (- width 500.0) (- height 176.0))
                      (r/v2 0.0 0.0)
                      0.0
                      (r/rgba 255 255 255 255))
    (r/EndShaderMode)
    (if (= (al/al-len (load (field snapshot entities))) 0)
        (let [x (+ 200.0 (* 0.5 (- width 500.0)))
              y (+ 76.0 (* 0.5 (- height 176.0)))]
          (r/DrawRectangle (cast i32 (- x 220.0))
                           (cast i32 (- y 48.0))
                           440
                           96
                           (r/rgba 11 17 21 230))
          (text v
                a
                "NO STRUCTURES IN THIS SNAPSHOT"
                (- x 195.0)
                (- y 24.0)
                18.0
                white)
          (text v
                a
                (cond (> (load (field v read-errors)) 0)
                        "Scan incomplete. See VERIFY for read errors."
                      (= current (al/al-len revisions))
                        "Watching saved files. New code will appear here."
                      :else
                        "Choose another revision, or press L to watch saved files.")
                (- x 195.0)
                (+ y 10.0)
                12.0
                muted)
          0)
        0)
    (text v a "ATLAS" 24.0 15.0 34.0 white)
    (label v a "A LIVING MAP OF THE CODEBASE" 164.0 31.0)
    (text v
          a
          "EXPLORE"
          (- width 665.0)
          31.0
          12.0
          (if (= (load (field v mode)) 0) amber muted))
    (text v
          a
          "UNDERSTAND"
          (- width 568.0)
          31.0
          12.0
          (if (= (load (field v mode)) 1) amber muted))
    (text v
          a
          "CHANGE"
          (- width 435.0)
          31.0
          12.0
          (if (= (load (field v mode)) 2) amber muted))
    (text v
          a
          "VERIFY"
          (- width 338.0)
          31.0
          12.0
          (if (= (load (field v mode)) 3) amber muted))
    (line 12.0 65.0 (- width 12.0) 65.0)
    (line 200.0 76.0 200.0 bottom)
    (line right 76.0 right bottom)
    (line 12.0 bottom (- width 12.0) bottom)
    (label v a "REPOSITORY" 20.0 89.0)
    (text v a "Folder archipelagos" 20.0 119.0 15.0 white)
    (text v
          a
          (if (load (field v show-borders)) "B Borders on" "B Borders off")
          20.0
          141.0
          10.0
          muted)
    (text v
          a
          (if (load (field v show-links)) "G Links on" "G Links off")
          112.0
          141.0
          10.0
          muted)
    (folder-tree-ui! v w snapshot a bottom)
    (territory-labels! v w a)
    (towns-ui! v w snapshot a)
    (let [at (load (field (field v folders) selected))]
      (if (and (>= at 0) (< (load (field v selected-island)) 0))
          (let [node (al/al-get (load (field (field w folders) nodes)) at)]
            (r/DrawRectangle 212
                             126
                             (cast i32 (- (load (field v width)) 532))
                             30
                             (r/rgba 10 20 24 235))
            (text v
                  a
                  (if (= at 0)
                      "Repository / Backspace: parent"
                      (load (field node path)))
                  224.0
                  132.0
                  15.0
                  (r/rgba 194 215 222 255))
            0)
          0))
    (if (load (field v loading-history))
        (do
          (r/DrawRectangle 212 164 440 34 (r/rgba 15 27 32 245))
          (text v
                a
                "Loading commit — map controls remain available"
                224.0
                172.0
                14.0
                (r/rgba 255 195 108 255))
          0)
        0)
    (label v a "ABSTRACTION" 20.0 (- bottom 155.0))
    (text v
          a
          (cond (> (load (field v zoom)) 35.0) "01   System"
                (> (load (field v zoom)) 15.0) "02   Module"
                (> (load (field v zoom)) 7.0) "03   Structure"
                :else "04   Member")
          20.0
          (- bottom 125.0)
          13.0
          amber)
