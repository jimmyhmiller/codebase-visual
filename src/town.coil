(module atlas.town)
(import "atlas.ray" :as r)
(import "atlas.terrain" :as terrain)
(import "atlas.glyphs" :as glyph)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)

;;; Authored civic-hall mesh, not a declaration glyph or a screen-space icon.
;;; Shared geometry supplies lighting, shadows and the same picking bounds.
;;; Maximum footprint stays inside the six-unit reservation in settlement layout.
(defn scale-for [(present i64)] (-> f64)
  (r/clamp (+ 0.7 (* 0.10 (r/sqrt (cast f64 present)))) 0.8 2.4))

(defn box! [(vs (ptr (al/ArrayList terrain/Vertex)))
            (x f64)
            (y f64)
            (z f64)
            (w f64)
            (h f64)
            (d f64)
            (c r/Color)] (-> i64)
  (glyph/box-into x (+ 1.99 y) z w h d c vs))

(defn face! [(vs (ptr (al/ArrayList terrain/Vertex)))
             (a r/Vector3)
             (b r/Vector3)
             (c r/Vector3)
             (d r/Vector3)
             (color r/Color)] (-> i64)
  (terrain/tri! vs a b c color)
  (terrain/tri! vs a c d color))

;;; Flat-faced distant silhouette. Fine bevels/windows are subpixel here; the
;;; plinth, wings, portico, roof and lantern remain real three-dimensional forms.
(defn flat-box! [(vs (ptr (al/ArrayList terrain/Vertex)))
                 (x f64)
                 (y f64)
                 (z f64)
                 (w f64)
                 (height f64)
                 (depth f64)
                 (color r/Color)] (-> i64)
  (let [x0 (- x (* w 0.5))
        x1 (+ x (* w 0.5))
        y0 (- (+ 1.99 y) (* height 0.5))
        y1 (+ (+ 1.99 y) (* height 0.5))
        z0 (- z (* depth 0.5))
        z1 (+ z (* depth 0.5))
        a (r/v3 x0 y0 z0)
        b (r/v3 x1 y0 z0)
        c (r/v3 x1 y1 z0)
        d (r/v3 x0 y1 z0)
        e (r/v3 x0 y0 z1)
        f (r/v3 x1 y0 z1)
        g (r/v3 x1 y1 z1)
        h (r/v3 x0 y1 z1)]
    (face! vs a d c b color)
    (face! vs e f g h color)
    (face! vs a e h d color)
    (face! vs b c g f color)
    (face! vs d h g c color)
    (face! vs a b f e color)))

(defn coarse-mesh [] (-> r/Model)
  (let [(mut vs) (al/al-new [terrain/Vertex] (alloc/malloc-allocator))
        pale (r/rgba 223 215 186 255)
        stone (r/rgba 161 167 151 255)
        roof (r/rgba 64 100 99 255)
        bronze (r/rgba 192 136 66 255)]
    (flat-box! (mut vs) 0.0 0.08 0.0 3.4 0.16 3.4 stone)
    (flat-box! (mut vs) 0.0 0.62 -0.18 1.52 0.9 1.56 pale)
    (flat-box! (mut vs) -1.03 0.47 -0.26 0.52 0.6 1.5 stone)
    (flat-box! (mut vs) 1.03 0.47 -0.26 0.52 0.6 1.5 stone)
    (flat-box! (mut vs) 0.0 1.1 0.88 1.83 0.13 0.57 pale)
    (flat-box! (mut vs) 0.0 1.22 -0.18 1.83 0.27 1.84 roof)
    (flat-box! (mut vs) 0.0 1.75 -0.18 0.5 0.45 0.5 pale)
    (flat-box! (mut vs) 0.0 2.02 -0.18 0.67 0.12 0.67 bronze)
    (flat-box! (mut vs) 0.0 2.21 -0.18 0.25 0.30 0.25 roof)
    (let [out (terrain/upload (load vs))] (al/al-free! (mut vs)) out)))

(defn mesh [] (-> r/Model)
  (let [(mut vs) (al/al-new [terrain/Vertex] (alloc/malloc-allocator))
        stone (r/rgba 161 167 151 255)
        pale (r/rgba 223 215 186 255)
        roof (r/rgba 64 100 99 255)
        bronze (r/rgba 192 136 66 255)
        dark (r/rgba 31 49 53 255)
        (mut i) 0]
    ;; Paved square, inset border and terraced approach.
    (box! (mut vs) 0.0 0.04 0.0 3.4 0.08 3.4 stone)
    (box! (mut vs) 0.0 0.10 0.0 3.16 0.04 3.16 dark)
    (box! (mut vs) 0.0 0.135 0.0 2.96 0.03 2.96 stone)
    (loop (if (>= (load i) 4) (break 0) 0)
      (let [step (cast f64 (load i))]
        (box! (mut vs)
              0.0
              (+ 0.16 (* step 0.07))
              (+ 0.96 (* step 0.12))
              (- 1.72 (* step 0.14))
              0.09
              (- 1.05 (* step 0.19))
              pale))
      (store! i (+ (load i) 1)))
    ;; Central hall with a deep portico and separate side wings.
    (box! (mut vs) 0.0 0.62 -0.18 1.52 0.90 1.56 pale)
    (box! (mut vs) 0.0 0.64 0.614 0.53 0.71 0.055 dark)
    (box! (mut vs) -1.03 0.47 -0.26 0.52 0.60 1.50 stone)
    (box! (mut vs) 1.03 0.47 -0.26 0.52 0.60 1.50 stone)
    (store! i 0)
    (loop (if (>= (load i) 4) (break 0) 0)
      (let [x (+ -0.70 (* (cast f64 (load i)) 0.467))]
        (box! (mut vs) x 0.62 0.94 0.11 0.86 0.11 pale)
        (box! (mut vs) x 1.055 0.94 0.18 0.09 0.18 bronze))
      (store! i (+ (load i) 1)))
    (box! (mut vs) 0.0 1.10 0.88 1.83 0.13 0.57 pale)
    (box! (mut vs) 0.0 1.12 -0.18 1.83 0.15 1.84 bronze)
    (box! (mut vs) -1.03 0.82 -0.26 0.65 0.12 1.62 roof)
    (box! (mut vs) 1.03 0.82 -0.26 0.65 0.12 1.62 roof)
    ;; Four concentric roof tiers, lantern tower and a copper crown.
    (store! i 0)
    (loop (if (>= (load i) 4) (break 0) 0)
      (let [step (cast f64 (load i))
            size (- 1.80 (* step 0.28))]
        (box! (mut vs) 0.0 (+ 1.23 (* step 0.10)) -0.18 size 0.11 size roof))
      (store! i (+ (load i) 1)))
    (box! (mut vs) 0.0 1.75 -0.18 0.50 0.45 0.50 pale)
    (box! (mut vs) 0.0 1.78 0.078 0.27 0.22 0.025 dark)
    (box! (mut vs) 0.0 2.01 -0.18 0.67 0.10 0.67 bronze)
    (box! (mut vs) 0.0 2.12 -0.18 0.43 0.13 0.43 roof)
    (box! (mut vs) 0.0 2.25 -0.18 0.08 0.22 0.08 bronze)
    ;; Recessed side windows and lamps flanking the square.
    (store! i 0)
    (loop (if (>= (load i) 3) (break 0) 0)
      (let [z (+ -0.78 (* (cast f64 (load i)) 0.49))]
        (box! (mut vs) -1.299 0.49 z 0.024 0.27 0.23 dark)
        (box! (mut vs) 1.299 0.49 z 0.024 0.27 0.23 dark))
      (store! i (+ (load i) 1)))
    (box! (mut vs) -1.38 0.43 1.28 0.07 0.57 0.07 bronze)
    (box! (mut vs) 1.38 0.43 1.28 0.07 0.57 0.07 bronze)
    (box! (mut vs) -1.38 0.73 1.28 0.18 0.19 0.18 pale)
    (box! (mut vs) 1.38 0.73 1.28 0.18 0.19 0.18 pale)
    (let [out (terrain/upload (load vs))] (al/al-free! (mut vs)) out)))

(defn bounds [(center r/Vector3) (present i64)] (-> r/BoundingBox)
  (let [s (scale-for present)
        x (cast f64 (load (field center x)))
        z (cast f64 (load (field center z)))]
    (r/BoundingBox :min (r/v3 (- x (* 1.7 s)) 1.99 (- z (* 1.7 s)))
      :max (r/v3 (+ x (* 1.7 s)) (+ 1.99 (* 2.36 s)) (+ z (* 1.7 s))))))
