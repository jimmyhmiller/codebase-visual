(module atlas.repository)
(import "atlas.model" :as m)
(import "atlas.analyzer" :as analyzer)
(import "atlas.ray" :as r)
(import "coil.str" :as str)
(import "coil.slice" :use [slice-len slice-get slice-new subslice])
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.os" :as os)

(cimport "git2.h"
         :flags
         ["-I/opt/homebrew/include"]
         :use
         [git_libgit2_init
          git_libgit2_shutdown
          git_repository_open
          git_repository_free
          git_repository_workdir
          git_revwalk_new
          git_revwalk_sorting
          git_revwalk_push_head
          git_revwalk_next
          git_revwalk_free
          git_commit_lookup
          git_commit_free
          git_commit_summary
          git_commit_author
          git_commit_tree
          git_commit_parentcount
          git_commit_parent
          git_commit_id
          git_oid_tostr
          git_oid_fromstr
          git_tree_entrycount
          git_tree_entry_byindex
          git_tree_entry_name
          git_tree_entry_type
          git_tree_entry_id
          git_tree_lookup
          git_tree_free
          git_blob_lookup
          git_blob_rawcontent
          git_blob_rawsize
          git_blob_is_binary
          git_blob_free
          git_repository
          git_commit
          git_oid
          git_revwalk
          git_tree
          git_tree_entry
          git_blob
          git_signature
          git_time
          git_index
          git_repository_init
          git_repository_index
          git_index_add_bypath
          git_index_write
          git_index_write_tree
          git_index_free
          git_signature_now
          git_signature_free
          git_commit_create_v
          git_ignore_path_is_ignored
          git_revparse_single
          git_object
          git_object_id
          git_object_free
          git_revwalk_push
          git_revwalk_simplify_first_parent
          git_tree_entry_filemode])

(defn env [(name (ptr i8))] (-> (ptr i8))
  (os/getenv name))

;;; Strict positive decimal parsing; reject overflow instead of wrapping or
;;; silently truncating a requested history window. -1 denotes invalid input.
(defn parse-history-limit [(text (slice u8))] (-> i64)
  (let [(mut n) 0
        (mut i) 0]
    (loop (if (>= (load i) (slice-len text))
              (break (if (> (load n) 0) (load n) -1))
              0)
      (let [digit (- (cast i64 (slice-get text (load i))) 48)]
        (if (or (< digit 0) (> digit 9)) (break -1) 0)
        (if (> (load n) (/ (- 9223372036854775807 digit) 10)) (break -1) 0)
        (store! n (+ (* (load n) 10) digit)))
      (store! i (+ (load i) 1)))))

(defn concat [(a (dyn alloc/Allocator)) (x (slice u8)) (y (slice u8))] (-> (slice u8))
  (match (str/str-concat a x y) (Some [s] s) (None [] (do (alloc/abort) ""))))

(defn copy [(a (dyn alloc/Allocator)) (s (slice u8))] (-> (slice u8))
  (concat a s ""))

(defn ctext [(a (dyn alloc/Allocator)) (p (ptr i8))] (-> (slice u8))
  (if (= (cast i64 p) 0) "" (copy a (str/cstr->str p))))

(defn open [(path (ptr i8))] (-> (ptr git_repository))
  (let [(mut repo) (cast (ptr git_repository) 0)]
    (let [status (git_repository_open (mut repo) path)]
      (if (< status 0)
          (do
            (println "Cannot open repository {} (libgit2 status {})"
                     (str/cstr->str path)
                     status)
            (cast (ptr git_repository) 0))
          (load repo)))))

(defn history-from [(a (dyn alloc/Allocator))
                    (repo (ptr git_repository))
                    (limit i64)
                    (revision (ptr i8))] (-> (al/ArrayList m/Revision))
  (history-walk a repo limit revision true))

(defn history-all-from [(a (dyn alloc/Allocator))
                        (repo (ptr git_repository))
                        (limit i64)
                        (revision (ptr i8))] (-> (al/ArrayList m/Revision))
  (history-walk a repo limit revision false))

(defn history-walk [(a (dyn alloc/Allocator))
                    (repo (ptr git_repository))
                    (limit i64)
                    (revision (ptr i8))
                    (first-parent bool)] (-> (al/ArrayList m/Revision))
  (let [(mut out) (al/al-new [m/Revision] a)
        (mut walk) (cast (ptr git_revwalk) 0)
        (mut oid) (zeroed git_oid)
        (mut count) 0]
    (if (= (git_revwalk_new (mut walk) repo) 0)
        (do
          (git_revwalk_sorting (load walk) (cast u32 3))
          (if first-parent
              (do (git_revwalk_simplify_first_parent (load walk)) 0)
              0)
          (if (= (cast i64 revision) 0)
              (git_revwalk_push_head (load walk))
              (let [(mut object) (cast (ptr git_object) 0)]
                (if (= (git_revparse_single (mut object) repo revision)
                       (cast i32 0))
                    (let [status
                            (git_revwalk_push (load walk)
                                              (git_object_id (load object)))]
                      (git_object_free (load object))
                      status)
                    (cast i32 -1))))
          (loop (if (or (>= (load count) limit)
                        (!= (git_revwalk_next (mut oid) (load walk))
                            (cast i32 0)))
                    (break 0)
                    0)
            (let [(mut commit) (cast (ptr git_commit) 0)
                  (mut buffer) (zeroed (array i8 41))]
              (if (= (git_commit_lookup (mut commit) repo (mut oid)) 0)
                  (do
                    (git_oid_tostr (index buffer 0) (cast u64 41) (mut oid))
                    (let [author (git_commit_author (load commit))]
                      (al/al-push! (mut out)
                                   (m/Revision
                                     :oid (ctext a (index buffer 0))
                                     :title
                                       (ctext a
                                              (git_commit_summary (load commit)))
                                     :author
                                       (ctext a (load (field author name))))))
                    (git_commit_free (load commit))
                    0)
                  0))
            (store! count (+ (load count) 1)))
          (git_revwalk_free (load walk))
          0)
        0)
    (let [n (al/al-len (load out))
          (mut i) 0]
      (loop (if (>= (load i) (/ n 2)) (break 0) 0)
        (let [v (al/al-get (load out) (load i))
              j (- (- n 1) (load i))]
          (al/al-set! (mut out) (load i) (al/al-get (load out) j))
          (al/al-set! (mut out) j v))
        (store! i (+ (load i) 1))))
    (load out)))

(defn history [(a (dyn alloc/Allocator))
               (repo (ptr git_repository))
               (limit i64)] (-> (al/ArrayList m/Revision))
  (history-from a repo limit (cast (ptr i8) 0)))

(defn supported? [(path (slice u8))] (-> bool)
  (let [n (slice-len path)]
    (or (and (>= n 5) (str/str-eq (subslice path (- n 5) n) ".coil"))
        (and (>= n 3)
             (or (str/str-eq (subslice path (- n 3) n) ".rs")
                 (or (str/str-eq (subslice path (- n 3) n) ".ts")
                     (str/str-eq (subslice path (- n 3) n) ".js"))))
        (and (>= n 2)
             (or (str/str-eq (subslice path (- n 2) n) ".c")
                 (str/str-eq (subslice path (- n 2) n) ".h")))
        (and (>= n 4)
             (or (str/str-eq (subslice path (- n 4) n) ".cpp")
                 (str/str-eq (subslice path (- n 4) n) ".tsx"))))))

(defn read-tree! [(registry (ptr analyzer/Registry))
                  (sink (ptr m/Snapshot))
                  (repo (ptr git_repository))
                  (tree (ptr git_tree))
                  (prefix (slice u8))] (-> i64)
  (let [a (load (field sink alc))
        n (cast i64 (git_tree_entrycount tree))
        (mut i) 0]
    (loop (if (>= (load i) n) (break 0) 0)
      (let [entry (git_tree_entry_byindex tree (cast u64 (load i)))
            path (concat a prefix (str/cstr->str (git_tree_entry_name entry)))
            kind (git_tree_entry_type entry)]
        (if (!= kind (cast i32 2)) (al/al-push! (field sink paths) path) 0)
        (cond (= kind (cast i32 2))
                (let [(mut child) (cast (ptr git_tree) 0)]
                  (if (= (git_tree_lookup (mut child)
                                          repo
                                          (git_tree_entry_id entry))
                         0)
                      (do
                        (read-tree! registry
                                    sink
                                    repo
                                    (load child)
                                    (concat a path "/"))
                        (git_tree_free (load child))
                        0)
                      0))
              (and (= kind (cast i32 3))
                   (!= (git_tree_entry_filemode entry) (cast i32 40960))
                   (>= (analyzer/lookup registry path) 0))
                (let [(mut blob) (cast (ptr git_blob) 0)]
                  (if (= (git_blob_lookup (mut blob)
                                          repo
                                          (git_tree_entry_id entry))
                         0)
                      (do
                        (let [size (cast i64 (git_blob_rawsize (load blob)))]
                          (if (and (= (git_blob_is_binary (load blob)) 0)
                                   (< size 2000000))
                              (analyzer/analyze-registered! registry
                                                            sink
                                                            path
                                                            (copy a
                                                                  (slice-new (cast (ptr u8)
                                                                                   (git_blob_rawcontent (load blob)))
                                                                             size)))
                              0))
                        (git_blob_free (load blob))
                        0)
                      0))
              :else 0))
      (store! i (+ (load i) 1)))
    0))

(defn snapshot [(a (dyn alloc/Allocator))
                (repo (ptr git_repository))
                (revision m/Revision)] (-> m/Snapshot)
  (let [(mut registry) (analyzer/defaults a)]
    (snapshot-with (mut registry) a repo revision)))

(defn parent-snapshot-with [(registry (ptr analyzer/Registry))
                            (a (dyn alloc/Allocator))
                            (repo (ptr git_repository))
                            (revision m/Revision)] (-> m/Snapshot)
  (let [(mut result) (m/new-snapshot a)
        (mut oid) (zeroed git_oid)
        (mut commit) (cast (ptr git_commit) 0)
        (mut parent) (cast (ptr git_commit) 0)
        (mut buffer) (zeroed (array i8 41))]
    (if (and (= (git_oid_fromstr (mut oid)
                                 (str/str->cstr a (load (field revision oid))))
                0)
             (= (git_commit_lookup (mut commit) repo (mut oid)) 0))
        (do
          (if (and (> (git_commit_parentcount (load commit)) (cast u32 0))
                   (= (git_commit_parent (mut parent)
                                         (load commit)
                                         (cast u32 0))
                      0))
              (do
                (git_oid_tostr (index buffer 0)
                               (cast u64 41)
                               (git_commit_id (load parent)))
                (store! result
                        (snapshot-with registry
                                       a
                                       repo
                                       (m/Revision
                                         :oid (ctext a (index buffer 0))
                                         :title "Parent"
                                         :author "")))
                (git_commit_free (load parent))
                0)
              0)
          (git_commit_free (load commit))
          0)
        0)
    (load result)))

(defn snapshot-with [(registry (ptr analyzer/Registry))
                     (a (dyn alloc/Allocator))
                     (repo (ptr git_repository))
                     (revision m/Revision)] (-> m/Snapshot)
  (let [(mut sink) (m/new-snapshot a)
        (mut oid) (zeroed git_oid)
        (mut commit) (cast (ptr git_commit) 0)
        (mut tree) (cast (ptr git_tree) 0)]
    (store! (field sink label) (load (field revision title)))
    (store! (field sink revision) (load (field revision oid)))
    (if (and (= (git_oid_fromstr (mut oid)
                                 (str/str->cstr a (load (field revision oid))))
                0)
             (= (git_commit_lookup (mut commit) repo (mut oid)) 0))
        (do
          (if (= (git_commit_tree (mut tree) (load commit)) 0)
              (do
                (read-tree! registry (mut sink) repo (load tree) "")
                (git_tree_free (load tree))
                0)
              0)
          (git_commit_free (load commit))
          0)
        (do (println "Cannot resolve commit {}" (load (field revision oid))) 0))
    (load sink)))
