(module atlas.instances)
(import "atlas.ray" :as r)
(import "coil.arraylist" :as al)

(defn flag! [(shader r/Shader) (location i32) (value (ptr i32))] (-> i64)
  (r/SetShaderValue shader location (cast (ptr u8) value) 4) 0)

;;; Raylib 5.5 binds four matrix attributes through SHADER_LOC_MATRIX_MODEL.
;;; Restore that slot and the instancing uniform before ordinary mesh drawing.
(defn transform [(x f64) (y f64) (z f64) (sx f64) (sy f64) (sz f64)] (-> r/Matrix)
  (let [(mut out) (zeroed r/Matrix)]
    (store! (field out m0) (cast f32 sx))
    (store! (field out m5) (cast f32 sy))
    (store! (field out m10) (cast f32 sz))
    (store! (field out m15) (cast f32 1.0))
    (store! (field out m12) (cast f32 x))
    (store! (field out m13) (cast f32 y))
    (store! (field out m14) (cast f32 z))
    (load out)))

(defn draw! [(model r/Model)
             (transforms (al/ArrayList r/Matrix))
             (color r/Color)
             (shader r/Shader)
             (shadow r/Texture)] (-> i64)
  (if (> (al/al-len transforms) 0)
      (let [material (index (load (field model materials)) 0)
            locs (load (field shader locs))
            saved (load (index locs 9))
            flag (r/GetShaderLocation shader c"useInstances")
            shadow-loc (r/GetShaderLocation shader c"shadowMap")
            (mut enabled) (cast i32 1)]
        (r/rlDrawRenderBatchActive)
        (store! (field material shader) shader)
        (store! (field (index (load (field material maps)) 0) color) color)
        (if (>= shadow-loc (cast i32 0))
            (do
              (store! (index locs 16) shadow-loc)
              (store! (field (index (load (field material maps)) 1) texture)
                      shadow))
            0)
        (store! (index locs 9)
                (r/GetShaderLocationAttrib shader c"instanceTransform"))
        (flag! shader flag enabled)
        (r/DrawMeshInstanced (load (index (load (field model meshes)) 0))
                             (load material)
                             (load (field transforms data))
                             (cast i32 (al/al-len transforms)))
        (store! enabled (cast i32 0))
        (flag! shader flag enabled)
        (store! (index locs 9) saved)
        (if (>= shadow-loc (cast i32 0))
            (do (r/SetShaderValueTexture shader shadow-loc shadow) 0)
            0)
        0)
      0))
