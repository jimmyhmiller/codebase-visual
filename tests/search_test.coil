(module atlas.tests.search)
(import "atlas.search" :as search)
(import "atlas.model" :as m)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.str" :as str)
(import "coil.scratch" :as scratch)

(deftest search-ranks-names-before-paths
         (let [(mut arena) (zeroed scratch/ScratchArena)]
           (scratch/scratch-init (mut arena) (alloc/malloc-allocator))
           (let [a (scratch/scratch-allocator (mut arena))
                 (mut s) (search/new-search a)
                 (mut snapshot) (m/new-snapshot a)]
             (m/emit! (mut snapshot) "order/file.coil" "Unrelated" 0 1 1 1)
             (m/emit! (mut snapshot) "x/file.coil" "OrderQueue" 0 1 1 2)
             (m/emit! (mut snapshot) "y/file.coil" "Order" 0 1 1 3)
             (search/append-codepoint! (mut s) 111)
             (search/append-codepoint! (mut s) 114)
             (search/append-codepoint! (mut s) 100)
             (search/append-codepoint! (mut s) 101)
             (search/append-codepoint! (mut s) 114)
             (search/refresh! (mut s) (mut snapshot))
             (assert-eq (al/al-len (load (field s results))) 3)
             (assert-eq (al/al-get (load (field s results)) 0) 2)
             (assert-eq (al/al-get (load (field s results)) 1) 1)
             (assert-eq (al/al-get (load (field s results)) 2) 0)
             (assert-eq (search/find-text "API/Order.coil" "api/order") 0)
             (assert-eq (search/find-text "tiny" "longer-query") -1)
             ;; A live snapshot may remove results while the search is open.
             (store! (field s cursor) 2)
             (al/al-clear! (mut (field snapshot entities)))
             (search/refresh! (mut s) (mut snapshot))
             (assert-eq (al/al-len (load (field s results))) 0)
             (assert-eq (load (field s cursor)) 0)
             (search/close! (mut s)))
           (scratch/scratch-close! (mut arena))))

(deftest search-edits-whole-utf8-codepoints
         (let [(mut s) (search/new-search (alloc/malloc-allocator))]
           (search/append-codepoint! (mut s) 65)
           (search/append-codepoint! (mut s) 233)
           (search/append-codepoint! (mut s) 128512)
           (assert (str/str-eq (search/query-text (mut s)) "Aé😀"))
           (search/backspace! (mut s))
           (assert (str/str-eq (search/query-text (mut s)) "Aé"))
           (search/backspace! (mut s))
           (assert (str/str-eq (search/query-text (mut s)) "A"))
           (search/append-codepoint! (mut s) 55296)
           (assert (str/str-eq (search/query-text (mut s)) "A"))
           (search/close! (mut s))))
