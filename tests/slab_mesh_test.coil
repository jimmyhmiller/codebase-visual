(module atlas.tests.slab-mesh)
(import "atlas.glyphs" :as glyph)
(import "atlas.ray" :as r)
(import "coil.arraylist" :as al)

(deftest slab-cache-preserves-levels-and-normalized-faces
         (let [(mut variant) 0]
           (loop (if (>= (load variant) 45) (break 0) 0)
             (let [levels (+ 3 (% (load variant) 9))
                   (mut vertices)
                     (glyph/generate-slabs levels (/ (load variant) 9))
                   (mut i) 0]
               ;; Two boxes per level, roof, recessed core and ten frame posts.
               (assert (= (al/al-len (load vertices))
                          (* (+ (* levels 2) 12) 84)))
               (loop (if (>= (load i) (al/al-len (load vertices))) (break 0) 0)
                 (let [v (al/al-get (load vertices) (load i))
                       n (load (field v normal))
                       p (load (field v p))]
                   (assert (< (r/fabs (- (glyph/vector-dot n n) 1.0)) 0.00001))
                   (assert (< (r/fabs (cast f64 (load (field p x)))) 0.581))
                   (assert (< (r/fabs (cast f64 (load (field p z)))) 0.476))
                   (assert (> (cast f64 (load (field p y))) 2.03499))
                   (assert (< (cast f64 (load (field p y)))
                              (+ 2.193 (* (cast f64 (- levels 1)) 0.24)))))
                 (store! i (+ (load i) 1)))
               (al/al-free! (mut vertices)))
             (store! variant (+ (load variant) 1)))))

(deftest slab-cache-selection-does-not-override-change-colors
         (assert (= (glyph/slab-cache-index 3 0 false) 0))
         (assert (= (glyph/slab-cache-index 3 0 true) 36))
         (assert (= (glyph/slab-cache-index 3 1 true) 9))
         (assert (= (glyph/slab-cache-index 3 2 true) 18))
         (assert (= (glyph/slab-cache-index 3 3 true) 27))
         (assert (= (glyph/slab-cache-index 11 0 true) 44)))

(deftest material-palette-separates-graphite-selection-and-edit-states
         (let [graphite (glyph/glyph-color 0 false)
               selected (glyph/glyph-color 0 true)
               (mut state) 1]
           ;; Cool graphite stays below the parchment selection in every channel.
           (assert (< (load (field graphite r)) (load (field graphite b))))
           (assert (< (load (field graphite r)) (load (field selected r))))
           (assert (< (load (field graphite g)) (load (field selected g))))
           (assert (< (load (field graphite b)) (load (field selected b))))
           (loop (if (> (load state) 3) (break 0) 0)
             (let [idle (glyph/glyph-color (load state) false)
                   focused (glyph/glyph-color (load state) true)]
               ;; Selection must never erase a modification/addition/removal state.
               (assert (= (load (field idle r)) (load (field focused r))))
               (assert (= (load (field idle g)) (load (field focused g))))
               (assert (= (load (field idle b)) (load (field focused b))))
               (assert (= (load (field idle a)) (load (field focused a)))))
             (store! state (+ (load state) 1)))))

(deftest thin-panel-bevels-do-not-cross
         (let [roof (glyph/box-bevel 0.98 0.010 0.77)
               cap (glyph/box-bevel 1.16 0.035 0.95)]
           (assert (> roof 0.0))
           (assert (< (* roof 2.0) 0.010))
           (assert (< (* cap 2.0) 0.035))
           (assert (< (r/fabs (- cap 0.009)) 0.000001))))

(deftest tree-material-is-pale-without-clipping-edit-hues
         (let [idle (glyph/tree-color 0 false)
               selected (glyph/tree-color 0 true)
               graphite (glyph/glyph-color 0 false)
               (mut state) 1]
           (assert (> (load (field idle r)) (load (field graphite r))))
           (assert (> (load (field idle g)) (load (field graphite g))))
           (assert (> (load (field idle b)) (load (field graphite b))))
           (assert (> (load (field selected r)) (load (field idle r))))
           (assert (< (load (field selected b)) (load (field idle b))))
           (loop (if (> (load state) 3) (break 0) 0)
             (let [color (glyph/tree-color (load state) false)
                   focus (glyph/tree-color (load state) true)
                   base (glyph/glyph-color (load state) false)]
               (assert (< (load (field color r)) (cast u8 255)))
               (assert (< (load (field color g)) (cast u8 255)))
               (assert (< (load (field color b)) (cast u8 255)))
               (assert (= (load (field color r)) (load (field focus r))))
               (assert (= (load (field color g)) (load (field focus g))))
               (assert (= (load (field color b)) (load (field focus b))))
               (assert (= (load (field color a)) (load (field base a))))
               (if (= (load state) 2)
                   (assert (> (load (field color g)) (load (field color r))))
                   (assert (> (load (field color r)) (load (field color g))))))
             (store! state (+ (load state) 1)))))
