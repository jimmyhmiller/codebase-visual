(module atlas.tests.cliff)
(import "atlas.terrain" :as terrain)
(import "atlas.landform" :as land)
(import "atlas.model" :as m)
(import "atlas.ray" :as r)

(deftest fractured-bed-warp-preserves-radial-order-and-endpoints
         (let [(mut seed) 0]
           (loop (if (>= (load seed) 8) (break 0) 0)
             (let [s (* (cast f64 (load seed)) 1.31)
                   radius (+ 5.0 (* s 11.0))
                   (mut angle-index) 0]
               (loop (if (>= (load angle-index) 64) (break 0) 0)
                 (let [angle (* (cast f64 (load angle-index)) 0.098174770425)
                       (mut step) 0
                       (mut previous) 0.0]
                   (assert (< (r/fabs (- (terrain/stratum-scale s
                                                                angle
                                                                (land/plateau-scale)
                                                                radius)
                                         (land/plateau-scale)))
                              0.000001))
                   (assert (< (r/fabs (- (terrain/stratum-scale s
                                                                angle
                                                                (land/coast-scale)
                                                                radius)
                                         (land/coast-scale)))
                              0.000001))
                   (loop (if (> (load step) 150) (break 0) 0)
                     (let [scale (* (cast f64 (load step)) 0.01)
                           warped (terrain/stratum-scale s angle scale radius)
                           actual (* warped (land/coast s angle warped))]
                       (assert (>= actual (load previous)))
                       (store! previous actual))
                     (store! step (+ (load step) 1))))
                 (store! angle-index (+ (load angle-index) 1))))
             (store! seed (+ (load seed) 1)))))

(deftest fracture-joints-are-periodic-bounded-and-continuous
         (let [(mut seed) 0]
           (loop (if (>= (load seed) 16) (break 0) 0)
             (let [s (* (cast f64 (load seed)) 0.71)
                   count (terrain/fracture-count (+ 5.0 (* s 8.0)))
                   (mut i) 0]
               (assert (< (r/fabs (- (terrain/fracture-noise s 0.0 count 71.0)
                                     (terrain/fracture-noise s
                                                             6.283185307179586
                                                             count
                                                             71.0)))
                          0.000001))
               (loop (if (>= (load i) 256) (break 0) 0)
                 (let [angle (* (cast f64 (load i)) 0.024543692606)
                       value (terrain/fracture-noise s angle count 71.0)
                       adjacent
                         (terrain/fracture-noise s
                                                 (+ angle 0.000001)
                                                 count
                                                 71.0)]
                   (assert (>= value -1.0))
                   (assert (<= value 1.0))
                   (assert (< (r/fabs (- value adjacent)) 0.0001)))
                 (store! i (+ (load i) 1))))
             (store! seed (+ (load seed) 1)))))

(deftest fractured-cliffs-preserve-bed-boundaries-and-rise
         (let [(mut seed) 0]
           (loop (if (>= (load seed) 8) (break 0) 0)
             (let [island
                     (m/Island
                       :name "cliff"
                       :seed (* (load seed) 83)
                       :position (r/v3 0.0 0.0 0.0)
                       :radius (+ 5.0 (* (cast f64 (load seed)) 12.0))
                       :count 0
                       :changed 0)
                   (mut layer) 0]
               (loop (if (>= (load layer) 7) (break 0) 0)
                 (let [l (cast f64 (load layer))
                       outer (- (land/coast-scale) (* l (land/stratum-width)))
                       inner (- outer (land/cliff-width))
                       y (+ -0.38 (* l 0.34))
                       (mut i) 0]
                   (loop (if (>= (load i) 128) (break 0) 0)
                     (let [angle (* (cast f64 (load i)) 0.049087385212)
                           bottom (terrain/stratum-point island angle outer y)
                           top
                             (terrain/stratum-point island
                                                    angle
                                                    inner
                                                    (+ y 0.28))
                           center (r/v3 0.0 0.0 0.0)
                           outer-radius (r/distance2 center bottom)
                           inner-radius (r/distance2 center top)
                           (mut step) 0
                           (mut last-y) -10.0]
                       (loop (if (> (load step) 12) (break 0) 0)
                         (let [t (/ (cast f64 (load step)) 12.0)
                               p
                                 (terrain/cliff-point island
                                                      angle
                                                      (load layer)
                                                      t)
                               radius (r/distance2 center p)
                               py (cast f64 (load (field p y)))]
                           (assert (<= radius (+ outer-radius 0.001)))
                           (assert (>= radius (- inner-radius 0.001)))
                           (assert (> py (load last-y)))
                           (store! last-y py)
                           (if (or (= (load step) 0) (= (load step) 12))
                               (let [edge (if (= (load step) 0) bottom top)]
                                 (assert (< (r/distance2 p edge) 0.000001))
                                 (assert (< (r/fabs (- py
                                                       (cast f64
                                                             (load (field edge
                                                                          y)))))
                                            0.000001)))
                               0))
                         (store! step (+ (load step) 1))))
                     (store! i (+ (load i) 1))))
                 (store! layer (+ (load layer) 1))))
             (store! seed (+ (load seed) 1)))))
