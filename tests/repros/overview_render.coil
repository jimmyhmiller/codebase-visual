(module atlas.repros.overview-render)
(import "atlas.repository" :as git)
(import "atlas.world" :as world)
(import "atlas.view" :as view)
(import "atlas.overview" :as overview)
(import "atlas.terrain" :as terrain)
(import "atlas.model" :as m)
(import "atlas.ray" :as r)
(import "atlas.search" :as search)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.scratch" :as scratch)

;;; Native, read-only rendering harness. This is not an interactive mode:
;;; production drill-down, camera fitting and live publication are still pending.
(defn close-view! [(v (ptr view/View))] (-> i64)
  (search/close! (field v search))
  (al/al-free! (mut (field v impact-distances)))
  (r/UnloadModel (load (field v terrain)))
  (terrain/unload-chunks! (field v terrain-chunks))
  (view/unload-proxies! v)
  (r/UnloadModel (load (field v proxy-model)))
  (r/UnloadModel (load (field v town-hall)))
  (r/UnloadModel (load (field v town-coarse)))
  (al/al-free! (field v island-counts))
  (view/close-folders! v)
  (al/al-free! (field v minimap-triangles))
  (r/UnloadModel (load (field v water)))
  (let [(mut i) 0]
    (loop (if (>= (load i) 45) (break 0) 0)
      (r/UnloadModel (load (index (field v slabs) (load i))))
      (if (< (load i) 17)
          (do (r/UnloadModel (load (index (field v trees) (load i)))) 0)
          0)
      (if (< (load i) 5)
          (do
            (r/UnloadModel (load (index (field v courtyards) (load i))))
            (r/UnloadModel (load (index (field v functions) (load i))))
            0)
          0)
      (store! i (+ (load i) 1))))
  (r/UnloadRenderTexture (load (field v texture)))
  (r/UnloadRenderTexture (load (field v minimap)))
  (r/UnloadRenderTexture (load (field v shadow)))
  (r/UnloadShader (load (field v light)))
  (r/UnloadShader (load (field v depth)))
  (r/UnloadShader (load (field v post)))
  (r/UnloadShader (load (field v ocean)))
  (r/UnloadFont (load (field v font)))
  0)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (git/git_libgit2_init)
  (let [(mut arena) (zeroed scratch/ScratchArena)]
    (scratch/scratch-init (mut arena) (alloc/malloc-allocator))
    (let [a (scratch/scratch-allocator (mut arena))
          repo
            (git/open (if (> argc (cast i32 1))
                          (load (index argv 1))
                          c"build/demo-v2"))
          revisions (git/history a repo 24)
          (mut snapshots) (al/al-new [m/Snapshot] a)
          (mut w) (world/new-world a)
          (mut i) 0]
      (loop (if (>= (load i) (al/al-len revisions)) (break 0) 0)
        (let [(mut s) (git/snapshot a repo (al/al-get revisions (load i)))]
          (if (> (load i) 0)
              (world/reconcile! (al/al-elem [m/Snapshot]
                                            (mut snapshots)
                                            (- (load i) 1))
                                (mut s))
              0)
          (world/register! (mut w) (mut s))
          (al/al-push! (mut snapshots) (load s)))
        (store! i (+ (load i) 1)))
      (world/pack! (mut w))
      (r/SetConfigFlags (cast u32 36))
      (r/InitWindow 1600 1000 c"Atlas system-landmark rendering regression")
      (r/SetTargetFPS 60)
      (let [current
              (if (> (al/al-len snapshots) 3) 3 (- (al/al-len snapshots) 1))
            s (al/al-elem [m/Snapshot] (mut snapshots) current)
            (mut v) (view/new-view (mut w))
            (mut groups)
              (overview/build s
                              (al/al-len (load (field w islands)))
                              (alloc/malloc-allocator))
            (mut vertices)
              (terrain/generate-with-landmarks (load (field w islands))
                                               (load (field w registry))
                                               true)
            (mut frames) (zeroed scratch/ScratchArena)
            capture (git/env c"ATLAS_CAPTURE")
            close (git/env c"ATLAS_PREVIEW_CLOSE")]
        ;; Group centroids refer to current world positions, not pre-pack sites.
        (world/apply-layout! (mut w) s)
        (overview/close! (mut groups))
        (store! groups
                (overview/build s
                                (al/al-len (load (field w islands)))
                                (alloc/malloc-allocator)))
        (r/UnloadModel (load (field v terrain)))
        (terrain/unload-chunks! (field v terrain-chunks))
        (store! (field v terrain) (terrain/upload (load vertices)))
        (al/al-free! (mut vertices))
        (view/fit-world! (mut v) (mut w))
        (if (!= (cast i64 close) 0)
            (let [island
                    (al/al-get (load (field w islands))
                               (if (> (al/al-len (load (field w islands))) 3)
                                   3
                                   0))]
              (store! (field v target) (load (field island position)))
              (store! (field v zoom) 30.0)
              (store! (field v pitch) 0.52))
            0)
        (store! (field v camera)
                (r/orbit-camera (load (field v target))
                                (load (field v yaw))
                                (load (field v pitch))
                                (load (field v zoom))))
        (scratch/scratch-init (mut frames) (alloc/malloc-allocator))
        (store! i 0)
        (loop (if (or (>= (load i) 100) (!= (r/WindowShouldClose) (cast u8 0)))
                  (break 0)
                  0)
          (store! (field v time) (/ (cast f64 (load i)) 60.0))
          (store! (field v age) 3.0)
          (view/scene-with-overview (mut v) (mut w) s (mut groups))
          (view/ui (mut v)
                   (mut w)
                   s
                   (scratch/scratch-allocator (mut frames))
                   revisions
                   current
                   false)
          (scratch/scratch-reset! (mut frames))
          (store! i (+ (load i) 1)))
        (let [image (r/LoadImageFromScreen)]
          (r/ExportImage image
                         (if (= (cast i64 capture) 0)
                             c"build/atlas-overview-preview.png"
                             capture))
          (r/UnloadImage image))
        (println "Overview render: groups={}, unmapped={}, zoom={}, fps={}"
                 (al/al-len (load (field groups groups)))
                 (load (field groups unmapped))
                 (load (field v zoom))
                 (r/GetFPS))
        (overview/close! (mut groups))
        (scratch/scratch-close! (mut frames))
        (close-view! (mut v)))
      (r/CloseWindow)
      (git/git_repository_free repo))
    (scratch/scratch-close! (mut arena)))
  (git/git_libgit2_shutdown)
  0)
