(module atlas.tests.sphere)
(import "atlas.ray" :as r)
(import "atlas.glyphs" :as glyph)

(deftest sphere-normals-are-unit-and-continuous-at-seam
         (let [(mut row) 0]
           (loop (if (> (load row) 16) (break 0) 0)
             (let [latitude
                     (+ -1.5707963267948966
                        (* (cast f64 (load row)) 0.19634954084936207))
                   a (glyph/sphere-normal latitude 0.0)
                   b (glyph/sphere-normal latitude 6.283185307179586)
                   x (cast f64 (load (field a x)))
                   y (cast f64 (load (field a y)))
                   z (cast f64 (load (field a z)))]
               (assert (< (r/fabs (- (+ (* x x) (+ (* y y) (* z z))) 1.0))
                          0.000001))
               (assert (< (r/distance2 a b) 0.000001)))
             (store! row (+ (load row) 1)))))

(deftest sphere-triangle-winds-outward
         (let [a (glyph/sphere-normal 0.0 0.0)
               b (glyph/sphere-normal 0.2 0.0)
               c (glyph/sphere-normal 0.0 0.3)
               uy
                 (- (cast f64 (load (field b y))) (cast f64 (load (field a y))))
               uz
                 (- (cast f64 (load (field b z))) (cast f64 (load (field a z))))
               vy
                 (- (cast f64 (load (field c y))) (cast f64 (load (field a y))))
               vz
                 (- (cast f64 (load (field c z))) (cast f64 (load (field a z))))]
           ;; At the equator on +X, an outward face has a positive cross-product X.
           (assert (> (- (* uy vz) (* uz vy)) 0.0))))
