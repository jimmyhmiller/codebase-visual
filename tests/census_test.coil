(module atlas.tests.census)
(import "atlas.model" :as m)
(import "coil.alloc" :as alloc)
(import "coil.scratch" :as scratch)
(import "coil.arraylist" :as al)

(deftest island-census-excludes-ghosts-and-other-modules
         (let [(mut arena) (zeroed scratch/ScratchArena)]
           (scratch/scratch-init (mut arena) (alloc/malloc-allocator))
           (let [a (scratch/scratch-allocator (mut arena))
                 (mut snapshot) (m/new-snapshot a)]
             (m/emit! (mut snapshot) "a.coil" "Present" 0 1 1 1)
             (m/emit! (mut snapshot) "a.coil" "Removed" 0 1 1 2)
             (m/emit! (mut snapshot) "b.coil" "Elsewhere" 1 1 1 3)
             (let [present (al/al-elem [m/Entity] (mut (field snapshot entities)) 0)
                   ghost (al/al-elem [m/Entity] (mut (field snapshot entities)) 1)
                   other (al/al-elem [m/Entity] (mut (field snapshot entities)) 2)]
               (store! (field present island) 0)
               (store! (field present state) 2)
               (store! (field ghost island) 0)
               (store! (field ghost state) 3)
               (store! (field other island) 1))
             (let [counts (m/island-census (mut snapshot) 0)
                   other (m/island-census (mut snapshot) 1)
                   empty (m/island-census (mut snapshot) 2)]
               (assert-eq (load (index counts 0)) 1)
               (assert-eq (load (index counts 1)) 0)
               (assert-eq (load (index other 1)) 1)
               (assert-eq (load (index empty 0)) 0)))
           (scratch/scratch-close! (mut arena))))
