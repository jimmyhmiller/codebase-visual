(module atlas.tests.layout)
(import "atlas.world" :as world)
(import "atlas.model" :as m)
(import "atlas.ray" :as r)
(import "coil.arraylist" :as al)
(import "coil.alloc" :as alloc)
(import "coil.scratch" :as scratch)
(import "coil.str" :as str)

(deftest source-file-districts-reserve-corridors-through-live-growth
         (let [(mut arena) (zeroed scratch/ScratchArena)]
           (scratch/scratch-init (mut arena) (alloc/malloc-allocator))
           (let [a (scratch/scratch-allocator (mut arena))
                 (mut w) (world/new-world a)
                 (mut repeat) (world/new-world a)
                 (mut snapshot) (m/new-snapshot a)
                 (mut positions) (al/al-new [r/Vector3] a)
                 (mut i) 0]
             ;; Interleaved discovery must still leave a corridor between files.
             (loop (if (>= (load i) 48) (break 0) 0)
               (m/emit! (mut snapshot)
                        (cond (= (% (load i) 3) 0) "order/types.coil"
                              (= (% (load i) 3) 1) "order/payment.coil"
                              :else "order/dispatch.coil")
                        (m/copy-text a
                                     (str/cstr->str (r/TextFormat c"District%lld"
                                                                  (load i))))
                        0
                        1
                        12
                        (load i))
               (store! i (+ (load i) 1)))
             (world/register! (mut w) (mut snapshot))
             (world/register! (mut repeat) (mut snapshot))
             (assert-eq (al/al-len (load (field w islands))) 3)
             (world/pack! (mut w))
             (world/pack! (mut repeat))
             (world/apply-layout! (mut w) (mut snapshot))
             (store! i 0)
             (loop (if (>= (load i) 48) (break 0) 0)
               (let [e (al/al-get (load (field snapshot entities)) (load i))
                     p (load (field e position))
                     original (al/al-get (load (field w registry)) (load i))
                     (mut j) 0]
                 (assert (< (r/distance2 p (load (field original position)))
                            0.000001))
                 (al/al-push! (mut positions) p)
                 (loop (if (>= (load j) (load i)) (break 0) 0)
                   (let [other
                           (al/al-get (load (field snapshot entities)) (load j))
                         same
                           (str/str-eq (load (field e path))
                                       (load (field other path)))]
                     (assert (>= (r/distance2 p (load (field other position)))
                                 (if same 5.2899 12.9599))))
                   (store! j (+ (load j) 1))))
               (store! i (+ (load i) 1)))
             ;; Preserve reservations even when a declaration disappears from the scan.
             (let [(mut next) (m/new-snapshot a)]
               (m/emit! (mut next)
                        "order/new-file.coil"
                        "NewDistrict"
                        0
                        1
                        12
                        99)
               (world/register-live! (mut w) (mut next))
               (let [fresh (al/al-get (load (field next entities)) 0)
                     p (load (field fresh position))]
                 (store! i 0)
                 (loop (if (>= (load i) 48) (break 0) 0)
                   (let [old (al/al-get (load (field w registry)) (load i))
                         before (al/al-get (load positions) (load i))]
                     (assert (< (r/distance2 before (load (field old position)))
                                0.000001))
                     (assert (>= (r/distance2 p before) 12.9599)))
                   (store! i (+ (load i) 1))))))
           (scratch/scratch-close! (mut arena))))

(deftest settlements-preserve-clearance-determinism-and-old-sites
         (let [(mut arena) (zeroed scratch/ScratchArena)]
           (scratch/scratch-init (mut arena) (alloc/malloc-allocator))
           (let [a (scratch/scratch-allocator (mut arena))
                 (mut first) (world/new-world a)
                 (mut second) (world/new-world a)
                 (mut snapshot) (m/new-snapshot a)
                 (mut positions) (al/al-new [r/Vector3] a)
                 (mut i) 0]
             (loop (if (>= (load i) 200) (break 0) 0)
               (m/emit! (mut snapshot)
                        "test.coil"
                        (m/copy-text a
                                     (str/cstr->str (r/TextFormat c"Building%lld"
                                                                  (load i))))
                        0
                        1
                        1
                        (load i))
               (store! i (+ (load i) 1)))
             (world/register! (mut first) (mut snapshot))
             (store! i 0)
             (loop (if (>= (load i) 200) (break 0) 0)
               (let [e (al/al-get (load (field snapshot entities)) (load i))
                     p (load (field e position))
                     (mut j) 0]
                 (al/al-push! (mut positions) p)
                 (loop (if (>= (load j) (load i)) (break 0) 0)
                   (assert (>= (r/distance2 p
                                            (al/al-get (load positions)
                                                       (load j)))
                               5.2899))
                   (store! j (+ (load j) 1))))
               (store! i (+ (load i) 1)))
             (world/register! (mut second) (mut snapshot))
             (m/emit! (mut snapshot) "test.coil" "NewNeighbor" 0 1 1 201)
             (world/register! (mut first) (mut snapshot))
             (store! i 0)
             (loop (if (>= (load i) 200) (break 0) 0)
               (let [e (al/al-get (load (field snapshot entities)) (load i))
                     other (al/al-get (load (field second registry)) (load i))
                     before (al/al-get (load positions) (load i))]
                 (assert (< (r/distance2 before (load (field e position)))
                            0.000001))
                 (assert (< (r/distance2 before (load (field other position)))
                            0.000001)))
               (store! i (+ (load i) 1))))
           (scratch/scratch-close! (mut arena))))

(deftest reference-neighborhood-outweighs-file-centroid
         (let [(mut arena) (zeroed scratch/ScratchArena)]
           (scratch/scratch-init (mut arena) (alloc/malloc-allocator))
           (let [a (scratch/scratch-allocator (mut arena))
                 (mut snapshot) (m/new-snapshot a)
                 (mut refs) (al/al-new [m/Reference] a)]
             (m/emit! (mut snapshot) "same.coil" "FilePeer" 0 1 1 1)
             (m/emit! (mut snapshot) "other.coil" "Target" 0 1 1 2)
             (m/emit! (mut snapshot) "same.coil" "New" 0 1 1 3)
             (let [left (al/al-elem [m/Entity] (field snapshot entities) 0)
                   right (al/al-elem [m/Entity] (field snapshot entities) 1)
                   fresh (al/al-get (load (field snapshot entities)) 2)]
               (store! (field left island) 0)
               (store! (field right island) 0)
               (store! (field left position) (r/v3 -10.0 2.0 0.0))
               (store! (field right position) (r/v3 10.0 2.0 0.0))
               (let [plain
                       (world/settlement-focus (load (field snapshot entities))
                                               (load refs)
                                               fresh
                                               0
                                               (r/v3 0.0 0.0 0.0))]
                 (assert (< (cast f64 (load (field plain x))) -6.0)))
               (al/al-push! (mut refs)
                            (m/Reference
                              :source (load (field fresh id))
                              :target "Target"
                              :module "root"))
               (let [linked
                       (world/settlement-focus (load (field snapshot entities))
                                               (load refs)
                                               fresh
                                               0
                                               (r/v3 0.0 0.0 0.0))]
                 (assert (> (cast f64 (load (field linked x))) 5.0)))))
           (scratch/scratch-close! (mut arena))))
