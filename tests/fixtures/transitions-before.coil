(module transitions)
(defstruct Unchanged [(id i64) (name (slice u8))])
(defstruct Modified [(id i64)])
(defstruct Removed [(id i64) (legacy-key (slice u8)) (expires i64)])
(defsum RemovedEnum (First) (Second) (Third))
(defstruct RemovedMap [(entries (slice i64)) (capacity i64)])
(defstruct RemovedTree [(children (slice i64)) (parent i64)])
(defstruct RemovedQueue [(head i64) (tail i64)])
(deftrait RemovedGraph [Self] (visit [(self Self)] (-> i64)))
(defn removed-function [] (-> i64) 41)
