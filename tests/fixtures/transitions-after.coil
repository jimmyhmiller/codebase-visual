(module transitions)
(defstruct Unchanged [(id i64) (name (slice u8))])
(defstruct Modified [(id i64) (priority i64)])
(defstruct Added [(id i64) (orders (slice i64)) (version i64) (count i64)])
(defsum AddedEnum (Normal) (Expedited) (Critical) (Deferred))
(defstruct AddedMap [(entries (slice i64)) (version i64) (size i64)])
(defstruct AddedTree [(children (slice i64)) (depth i64) (active bool)])
(defstruct AddedQueue [(head i64) (tail i64) (capacity i64)])
(deftrait AddedGraph [Self] (connect [(self Self) (target i64)] (-> i64)))
(defn added-function [] (-> i64) 42)
