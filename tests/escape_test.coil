(module atlas.tests.escape)
(import "atlas.view" :as view)

(deftest escape-dismisses-one-visible-layer-before-exiting
         (let [(mut v) (zeroed view/View)]
           (store! (field v selected-island) -1)
           (store! (field (field v search) active) true)
           (store! (field v help) true)
           (store! (field v source-open) true)
           (store! (field v selected) 4)
           (store! (field v selected-member) 2)
           (store! (field v zoom) 5.0)
           (assert (not (view/escape! (mut v))))
           (assert (not (load (field (field v search) active))))
           (assert (load (field v help)))
           (assert (not (view/escape! (mut v))))
           (assert (not (load (field v help))))
           (assert (load (field v source-open)))
           (assert (not (view/escape! (mut v))))
           (assert (not (load (field v source-open))))
           (assert (= (load (field v selected-member)) 2))
           (assert (not (view/escape! (mut v))))
           (assert (= (load (field v selected-member)) -1))
           (assert (= (load (field v selected)) 4))
           (assert (not (view/escape! (mut v))))
           (assert (= (load (field v selected)) -1))
           (assert (view/escape! (mut v)))))

(deftest escape-does-not-dismiss-invisible-source-preference
         (let [(mut v) (zeroed view/View)]
           (store! (field v selected-island) -1)
           (store! (field v source-open) true)
           (store! (field v selected) 3)
           (store! (field v selected-member) 1)
           (store! (field v zoom) 80.0)
           (assert (not (view/escape! (mut v))))
           (assert (= (load (field v selected)) -1))
           (assert (= (load (field v selected-member)) -1))
           (assert (load (field v source-open)))
           (assert (view/escape! (mut v)))))
